---
import type { SocialLinks } from '../lib/types';
import { SITE } from '../data/site';

interface Props {
  social?: SocialLinks;
  thumbnail?: string;
  itemTitle: string;
}

const { social, thumbnail, itemTitle } = Astro.props;
const hasYoutube = Boolean(social?.youtubeUrl);
const hasInstagram = Boolean(social?.instagramUrl);
---

<section class="tactile-card p-6">
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#E4E4E7]">
    <div class="flex items-center gap-2.5 flex-wrap">
      <span class="badge-pill badge-neutral font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF0000]"></span>
        VİDEO & SOSYAL MEDYA
      </span>
      <h3 class="text-sm sm:text-base font-semibold text-[#111111]">
        {hasYoutube ? 'Bu Analizin YouTube Videosu Yayında' : 'Web-Özel Bağımsız Derecelendirme'}
      </h3>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      {hasYoutube && (
        <a
          href={social!.youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill btn-pill-primary !py-2 !px-3.5 !text-xs"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF0000]"></span>
          YouTube'da İzle <span class="arrow">↗</span>
        </a>
      )}
      {hasInstagram && (
        <a
          href={social!.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill btn-pill-outline !py-2 !px-3.5 !text-xs"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#E1306C]"></span>
          Instagram ↗
        </a>
      )}
    </div>
  </div>

  {hasYoutube ? (
    <div class="mt-5 grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
      {thumbnail && (
        <a
          href={social!.youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="md:col-span-5 relative group rounded-[14px] overflow-hidden border border-[#E4E4E7] block"
        >
          <img
            src={thumbnail}
            alt={social?.youtubeTitle || itemTitle}
            class="w-full aspect-video object-cover group-hover:scale-[1.03] transition duration-300"
          />
          <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition flex items-center justify-center">
            <div class="w-12 h-12 rounded-2xl bg-[#111111]/95 flex items-center justify-center shadow-lg group-hover:scale-105 transition">
              <svg class="w-5 h-5 fill-[#FBD101] ml-0.5" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>
        </a>
      )}
      <div class={thumbnail ? 'md:col-span-7 space-y-3' : 'md:col-span-12 space-y-3'}>
        <p class="text-sm text-[#52525B] leading-relaxed">
          <strong class="text-[#111111]">{social?.youtubeTitle || itemTitle}</strong> — Görsel kıyaslamalar, sesli uzman anlatımı ve yorumlar <a href={SITE.social.youtubeUrl} target="_blank" class="text-[#02458A] font-medium hover:underline">{SITE.social.youtubeHandle}</a> kanalımızda.
        </p>

        {social?.chapters && social.chapters.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pt-1">
            {social.chapters.map((ch) => (
              <div class="flex items-center gap-2 text-xs bg-[#F9FAFB] border border-[#E4E4E7] rounded-lg px-2.5 py-1.5">
                <span class="font-mono font-semibold text-[#02458A] shrink-0">{ch.time}</span>
                <span class="text-[#52525B] truncate">{ch.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class="mt-4 bg-[#F9FAFB] border border-[#E4E4E7] rounded-[14px] p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <p class="text-xs sm:text-sm text-[#52525B] leading-relaxed">
        Bu inceleme <strong class="text-[#111111]">doğrudan hepsievegelsin.com için hazırlanmış bağımsız web derecelendirmesidir</strong>. YouTube videosu veya Instagram Reels yayınlandığında bağlantısı burada otomatik aktif olur.
      </p>
      <a
        href={SITE.social.youtubeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-pill btn-pill-outline !py-2 !px-3.5 !text-xs shrink-0"
      >
        Tüm Videolar ↗
      </a>
    </div>
  )}
</section>
