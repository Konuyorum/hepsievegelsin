---
import type { ScoreCriterion, VerdictKey } from '../lib/types';
import VerdictBadge from './VerdictBadge.astro';
import SparkBars from './SparkBars.astro';

interface Props {
  score: number;
  verdict: VerdictKey;
  criteria: ScoreCriterion[];
  verdictHeadline?: string;
}

const { score, verdict, criteria, verdictHeadline } = Astro.props;

function getTone(val: number): 'yellow' | 'blue' | 'neutral' | 'red' {
  if (val >= 9.0) return 'yellow';
  if (val >= 7.5) return 'blue';
  if (val >= 6.5) return 'neutral';
  return 'red';
}
---

<section class="tactile-card p-6 sm:p-7" aria-label="HEG 5 Kriterli Bağımsız Derecelendirme">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[#E4E4E7]">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="badge-pill badge-blue font-mono">5 KRİTERLİ BAĞIMSIZ KARNE</span>
      </div>
      {verdictHeadline && (
        <h2 class="text-lg sm:text-xl font-semibold tracking-[-0.02em] text-[#111111]">
          {verdictHeadline}
        </h2>
      )}
    </div>

    <div class="flex items-center gap-4 shrink-0">
      <div class="text-right">
        <div class="font-mono font-bold text-4xl tracking-[-0.04em] text-[#111111] tabular-nums leading-none">
          {score.toFixed(1)}<span class="text-base text-[#71717A] font-medium">/10</span>
        </div>
        <div class="mt-2">
          <VerdictBadge verdict={verdict} size="sm" />
        </div>
      </div>
    </div>
  </div>

  <!-- Tactile Barcode Sparkline Criteria Rows -->
  <div class="divide-y divide-[#E4E4E7]">
    {criteria.map((item) => (
      <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="max-w-2xl">
          <div class="text-sm font-semibold text-[#111111]">{item.label}</div>
          <p class="text-xs text-[#52525B] mt-0.5 leading-relaxed">{item.summary}</p>
        </div>
        <div class="flex items-center gap-3 shrink-0 font-mono">
          <SparkBars score={item.score} tone={getTone(item.score)} />
          <span class="text-sm font-bold text-[#111111] tabular-nums w-12 text-right">
            {item.score.toFixed(1)}/10
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-4 pt-4 border-t border-dashed border-[#E4E4E7] flex flex-wrap items-center justify-between gap-2 text-xs text-[#71717A]">
    <span class="font-mono text-[11px]">Teknik veri + çoklu mağaza fiyat geçmişi + gerçek kullanıcı yorum sentezi</span>
    <a href="/metodoloji" class="font-semibold text-[#02458A] hover:underline">
      Puanlama Metodolojimiz ↗
    </a>
  </div>
</section>
