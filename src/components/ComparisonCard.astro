---
import type { ComparisonArticle } from '../lib/types';
import { formatTRY } from '../data/site';
import SparkBars from './SparkBars.astro';

interface Props {
  comparison: ComparisonArticle;
}

const { comparison } = Astro.props;
const hasYoutube = Boolean(comparison.social?.youtubeUrl);
---

<article class="tactile-card tactile-card-hover overflow-hidden flex flex-col h-full group">
  <!-- Clean Media Header -->
  <a href={`/vs/${comparison.slug}`} class="relative block aspect-[16/9] overflow-hidden bg-[#F9FAFB] border-b border-[#E4E4E7]">
    <img
      src={comparison.thumbnail}
      alt={comparison.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500"
    />
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
      <span class="badge-pill badge-deal font-mono shadow-sm">
        {comparison.hookBadge}
      </span>
      {hasYoutube ? (
        <span class="badge-pill bg-white/95 text-[#111111] border border-[#E4E4E7] font-mono shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF0000]"></span>
          YOUTUBE + WEB
        </span>
      ) : (
        <span class="badge-pill badge-blue font-mono shadow-sm">
          WEB-ÖZEL VS
        </span>
      )}
    </div>
  </a>

  <!-- Crisp Scoreboard Strip (Zero overlap!) -->
  <div class="px-5 py-2.5 bg-[#F9FAFB] border-b border-[#E4E4E7] flex items-center justify-between gap-2 font-mono text-xs">
    <span class="text-[#71717A] uppercase text-[10.5px]">RAUND SKORU</span>
    <div class="flex items-center gap-2 font-bold">
      <span class="text-[#02458A]">{comparison.productA.shortName}</span>
      <span class="bg-[#111111] text-white px-2 py-0.5 rounded-full tabular-nums">{comparison.scoreA}</span>
      <span class="text-[#71717A]">–</span>
      <span class="bg-[#FBD101] text-[#1A1500] px-2 py-0.5 rounded-full tabular-nums">{comparison.scoreB}</span>
      <span class="text-[#111111]">{comparison.productB.shortName}</span>
    </div>
  </div>

  <!-- Body -->
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center justify-between text-[11px] font-mono text-[#71717A] mb-1.5">
      <span class="uppercase">{comparison.category}</span>
      <span>{comparison.displayDate}</span>
    </div>

    <a href={`/vs/${comparison.slug}`}>
      <h3 class="text-[18px] font-semibold tracking-[-0.02em] text-[#111111] group-hover:text-[#0251A0] transition leading-snug">
        {comparison.title}
      </h3>
    </a>
    <p class="text-[13px] text-[#52525B] mt-1.5 line-clamp-2 leading-relaxed flex-1">
      {comparison.subtitle}
    </p>

    <!-- Tactile Contender Rows with SparkBars -->
    <div class="mt-4 pt-3.5 border-t border-dashed border-[#E4E4E7] space-y-2.5 text-xs">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <span class="font-semibold text-[#111111] truncate">{comparison.productA.shortName}</span>
          {comparison.winnerSide === 'A' && <span class="badge-pill badge-deal font-mono !text-[9.5px] !py-0 !px-2">KAZANAN</span>}
        </div>
        <div class="flex items-center gap-2.5 font-mono shrink-0">
          <SparkBars score={comparison.productA.hegScore} tone={comparison.winnerSide === 'A' ? 'yellow' : 'blue'} />
          <strong class="text-[#111111] tabular-nums">{formatTRY(comparison.productA.lowestPrice)}</strong>
        </div>
      </div>

      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <span class="font-semibold text-[#111111] truncate">{comparison.productB.shortName}</span>
          {comparison.winnerSide === 'B' && <span class="badge-pill badge-deal font-mono !text-[9.5px] !py-0 !px-2">KAZANAN</span>}
        </div>
        <div class="flex items-center gap-2.5 font-mono shrink-0">
          <SparkBars score={comparison.productB.hegScore} tone={comparison.winnerSide === 'B' ? 'yellow' : 'blue'} />
          <strong class="text-[#111111] tabular-nums">{formatTRY(comparison.productB.lowestPrice)}</strong>
        </div>
      </div>
    </div>

    <div class="mt-4 flex items-center gap-2">
      <a href={`/vs/${comparison.slug}`} class="btn-pill btn-pill-primary flex-1 !py-2.5 !text-xs">
        Raund Analizini Aç <span class="arrow">↗</span>
      </a>
      {hasYoutube && (
        <a
          href={comparison.social!.youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill btn-pill-outline btn-pill-video !py-2.5 !px-3.5 !text-xs"
          title="YouTube'da İzle"
        >
          ▶
        </a>
      )}
    </div>
  </div>
</article>
