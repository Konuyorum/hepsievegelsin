---
import type { ProductReview } from '../lib/types';
import { formatTRY, VERDICT_META } from '../data/site';

interface Props {
  product: ProductReview;
}

const { product } = Astro.props;
const verdictMeta = VERDICT_META[product.verdict];
const lowestOffer = product.offers.find((o) => o.isLowest) || product.offers[0];
const cleanStoreLabel = (lowestOffer ? lowestOffer.store.split('(')[0].trim() : product.brand).toUpperCase();
const hasYoutube = Boolean(product.social?.youtubeUrl);

const topBadgeText = product.isFakeDealAlert
  ? `UYARI · ${product.hegScore.toFixed(1)}/10`
  : product.discountPercent > 0
    ? `-%${product.discountPercent} · ${product.hegScore.toFixed(1)}/10`
    : `${verdictMeta.shortLabel} · ${product.hegScore.toFixed(1)}/10`;
---

<article class="tactile-card tactile-card-hover overflow-hidden flex flex-col h-full group">
  <!-- Clean #F9FAFB Studio Photo Stage -->
  <a href={`/urun/${product.slug}`} class="relative block bg-[#F9FAFB] h-[220px] p-4 border-b border-[#E4E4E7] overflow-hidden">
    <div class="absolute top-3 left-3 right-3 z-10 flex items-center justify-between gap-2">
      <span class={`badge-pill font-mono whitespace-nowrap ${product.isFakeDealAlert ? 'badge-hot' : 'badge-deal'}`}>
        {topBadgeText}
      </span>
      <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.04em] text-[#52525B] bg-white/95 border border-[#E4E4E7] px-2 py-0.5 rounded-md whitespace-nowrap truncate max-w-[115px]">
        {cleanStoreLabel}
      </span>
    </div>

    <div class="w-full h-full flex items-center justify-center pt-4">
      <img
        src={product.image}
        alt={`${product.name} — HEG Tarafsız İnceleme`}
        loading="lazy"
        class="deal-photo max-h-full max-w-full object-contain group-hover:scale-[1.04]"
      />
    </div>
  </a>

  <!-- Airy Swiss Editorial Body -->
  <div class="p-[18px] flex flex-col flex-1">
    <div class="flex items-center justify-between gap-2 mb-1.5">
      <span class="text-[11px] font-mono text-[#71717A] uppercase">{product.category}</span>
      {hasYoutube ? (
        <span class="badge-pill badge-blue font-mono !text-[10px] !py-0.5 !px-2">TEST EDİLDİ · YT</span>
      ) : (
        <span class="badge-pill badge-neutral font-mono !text-[10px] !py-0.5 !px-2">WEB ANALİZİ</span>
      )}
    </div>

    <a href={`/urun/${product.slug}`} class="block">
      <h3 class="text-[15.5px] font-semibold tracking-[-0.01em] text-[#111111] leading-[1.35] group-hover:text-[#0251A0] transition line-clamp-2">
        {product.name}
      </h3>
    </a>

    <p class="text-[12.5px] text-[#52525B] mt-1.5 mb-3.5 line-clamp-2 leading-relaxed flex-1">
      {product.verdictHeadline}
    </p>

    <!-- Tabular Price Hierarchy -->
    <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1 mb-3.5 tabular-nums">
      <div class="flex items-baseline gap-1.5 flex-wrap">
        <span class="text-[19px] xl:text-[20px] font-bold tracking-[-0.02em] text-[#111111] font-mono whitespace-nowrap">
          {formatTRY(product.currentLowestPrice)}
        </span>
        {product.listPrice > product.currentLowestPrice && (
          <span class="text-[12px] text-[#71717A] line-through font-mono whitespace-nowrap">
            {formatTRY(product.listPrice)}
          </span>
        )}
      </div>
      {!product.isFakeDealAlert && product.netSavings > 0 && (
        <span class="text-[11px] font-mono font-semibold text-[#02458A] whitespace-nowrap">
          +{formatTRY(product.netSavings)}
        </span>
      )}
    </div>

    <!-- Single Clear Tactile Black Pill CTA + Optional Video Micro-Button -->
    <div class="flex items-center gap-2">
      <a
        href={`/urun/${product.slug}`}
        class="btn-pill btn-pill-primary flex-1 !py-2.5 !text-xs"
      >
        {product.isFakeDealAlert ? 'Neden Alınmaz?' : 'İncele & Fiyatlar'} <span class="arrow">↗</span>
      </a>
      {hasYoutube && (
        <a
          href={product.social!.youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill btn-pill-outline btn-pill-video !py-2.5 !px-3.5 !text-xs"
          title="YouTube video incelemesini izle"
        >
          ▶
        </a>
      )}
    </div>
  </div>
</article>
