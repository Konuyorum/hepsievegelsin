---
import { VERDICT_META } from '../data/site';
import type { VerdictKey } from '../lib/types';

interface Props {
  verdict: VerdictKey;
  score?: number;
  size?: 'sm' | 'md' | 'lg';
}

const { verdict, score, size = 'md' } = Astro.props;
const meta = VERDICT_META[verdict];

const sizeMap = {
  sm: 'text-[10.5px] px-2.5 py-0.5',
  md: 'text-[11px] px-3 py-1',
  lg: 'text-xs px-3.5 py-1.5',
}[size];
---

<span class={`badge-pill font-mono uppercase ${meta.badgeClass} ${sizeMap}`}>
  <span>{meta.label}</span>
  {score !== undefined && (
    <span class="pl-1.5 ml-0.5 border-l border-current/25 tabular-nums font-bold">
      {score.toFixed(1)}/10
    </span>
  )}
</span>
