---
import { getAllProducts, getAllComparisons } from '../lib/content';
import { formatTRY } from '../data/site';

const products = getAllProducts().map((p) => ({
  type: 'urun' as const,
  title: p.name,
  subtitle: `${p.category} • ${formatTRY(p.currentLowestPrice)}`,
  score: p.hegScore.toFixed(1),
  href: `/urun/${p.slug}`,
  keywords: `${p.name} ${p.brand} ${p.category} ${p.subtitle}`.toLowerCase(),
}));

const comparisons = getAllComparisons().map((c) => ({
  type: 'vs' as const,
  title: c.title,
  subtitle: `HEG VS • ${c.hookBadge}`,
  score: `${c.scoreA}-${c.scoreB}`,
  href: `/vs/${c.slug}`,
  keywords: `${c.title} ${c.productA.name} ${c.productB.name} ${c.category}`.toLowerCase(),
}));

const searchIndex = [...comparisons, ...products];
---

<div class="w-full" id="hegHeroSearch">
  <div class="bg-white/[0.06] backdrop-blur-xl border border-white/15 rounded-2xl p-2 shadow-2xl">
    <form id="heroSearchForm" class="space-y-2">
      <div class="flex flex-col sm:flex-row gap-2">
        <div class="relative flex-1">
          <input
            id="heroQ1"
            type="text"
            autocomplete="off"
            placeholder="Ürün ara: Roborock S8, Z Fold 8, Liberty 4 NC..."
            class="w-full bg-[#070B14]/80 text-white placeholder-slate-400 px-4 py-3.5 rounded-xl text-sm sm:text-base font-medium border border-white/10 focus:border-[#FAD002] focus:outline-none transition"
          />
        </div>
        <button
          id="heroVsToggle"
          type="button"
          class="px-4 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-slate-200 border border-white/10 text-xs font-mono font-bold uppercase tracking-wider transition shrink-0 cursor-pointer"
        >
          ⚖️ VS Modu
        </button>
        <button
          type="submit"
          class="px-6 py-3.5 rounded-xl bg-[#FAD002] hover:bg-[#ffe03a] text-[#0B0B0D] font-extrabold text-sm tracking-wide transition shadow-lg shadow-[#FAD002]/20 shrink-0 cursor-pointer"
        >
          ANALİZ ET →
        </button>
      </div>

      <div id="heroVsWrap" class="hidden">
        <input
          id="heroQ2"
          type="text"
          autocomplete="off"
          placeholder="Karşılaştırılacak 2. Ürün (Örn: Apple iPhone Duo, Dreame L10s Ultra...)"
          class="w-full bg-[#070B14]/80 text-white placeholder-slate-400 px-4 py-3.5 rounded-xl text-sm sm:text-base font-medium border border-[#03519F]/70 focus:border-[#FAD002] focus:outline-none transition"
        />
      </div>
    </form>

    <!-- Instant Verified Match Dropdown -->
    <div id="heroSuggestions" class="hidden mt-2 bg-[#0B1120] border border-white/15 rounded-xl overflow-hidden divide-y divide-white/10"></div>
  </div>

  <!-- Quick Pills -->
  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
    <span class="text-slate-400 font-mono text-[11px]">POPÜLER:</span>
    <a href="/vs/galaxy-z-fold-8-vs-iphone-duo" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-[#03519F] text-slate-200 hover:text-white transition font-medium">
      Z Fold 8 vs iPhone Duo
    </a>
    <a href="/urun/roborock-s8" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-[#03519F] text-slate-200 hover:text-white transition font-medium">
      Roborock S8
    </a>
    <a href="/urun/anker-soundcore-liberty-4-nc" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-[#03519F] text-slate-200 hover:text-white transition font-medium">
      Liberty 4 NC
    </a>
    <a href="/urun/apple-airpods-4-standart" class="px-2.5 py-1 rounded-lg bg-red-500/20 hover:bg-red-600 text-red-200 hover:text-white border border-red-500/30 transition font-medium">
      ⚠ AirPods 4 Uyarısı
    </a>
  </div>
</div>

<script define:vars={{ searchIndex }}>
  const q1 = document.getElementById('heroQ1');
  const q2 = document.getElementById('heroQ2');
  const vsBtn = document.getElementById('heroVsToggle');
  const vsWrap = document.getElementById('heroVsWrap');
  const form = document.getElementById('heroSearchForm');
  const suggBox = document.getElementById('heroSuggestions');
  let isVs = false;

  vsBtn?.addEventListener('click', () => {
    isVs = !isVs;
    vsWrap?.classList.toggle('hidden', !isVs);
    if (vsBtn) {
      vsBtn.textContent = isVs ? '✕ VS Kapat' : '⚖️ VS Modu';
      vsBtn.classList.toggle('bg-[#03519F]', isVs);
      vsBtn.classList.toggle('text-white', isVs);
    }
    if (isVs) q2?.focus();
  });

  q1?.addEventListener('input', () => {
    const val = q1.value.trim().toLowerCase();
    if (!val || val.length < 2) {
      suggBox?.classList.add('hidden');
      return;
    }
    const matches = searchIndex.filter((item) => item.keywords.includes(val)).slice(0, 4);
    if (matches.length === 0) {
      suggBox?.classList.add('hidden');
      return;
    }
    if (suggBox) {
      suggBox.innerHTML = matches
        .map(
          (m) => `
        <a href="${m.href}" class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-white/10 transition">
          <div>
            <div class="text-xs font-mono uppercase text-[#FAD002]">${m.type === 'vs' ? 'DOĞRULANMIŞ HEG VS' : 'DOĞRULANMIŞ HEG İNCELEMESİ'}</div>
            <div class="text-sm font-bold text-white">${m.title}</div>
            <div class="text-xs text-slate-400">${m.subtitle}</div>
          </div>
          <span class="font-mono font-extrabold text-xs bg-[#03519F] text-white px-2.5 py-1 rounded-lg shrink-0">${m.score}</span>
        </a>`
        )
        .join('');
      suggBox.classList.remove('hidden');
    }
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('hegHeroSearch')?.contains(e.target)) {
      suggBox?.classList.add('hidden');
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v1 = q1?.value.trim() || '';
    const v2 = q2?.value.trim() || '';
    if (!v1) {
      q1?.focus();
      return;
    }
    if (isVs && v2) {
      window.location.href = `/asistan?vs=1&q1=${encodeURIComponent(v1)}&q2=${encodeURIComponent(v2)}`;
    } else {
      window.location.href = `/asistan?ara=${encodeURIComponent(v1)}`;
    }
  });
</script>
