---
import { getAllProducts, getAllComparisons } from '../lib/content';
import { formatTRY } from '../data/site';

const products = getAllProducts().map((p) => ({
  type: 'urun' as const,
  title: p.name,
  subtitle: `${p.category} · ${formatTRY(p.currentLowestPrice)}`,
  score: `${p.hegScore.toFixed(1)}/10`,
  href: `/urun/${p.slug}`,
  keywords: `${p.name} ${p.brand} ${p.category} ${p.subtitle}`.toLowerCase(),
}));

const comparisons = getAllComparisons().map((c) => ({
  type: 'vs' as const,
  title: c.title,
  subtitle: `HEG VS · ${c.hookBadge}`,
  score: `${c.scoreA}–${c.scoreB}`,
  href: `/vs/${c.slug}`,
  keywords: `${c.title} ${c.productA.name} ${c.productB.name} ${c.category}`.toLowerCase(),
}));

const searchIndex = [...comparisons, ...products];
---

<div class="w-full relative" id="hegHeroSearch">
  <div class="tactile-card p-2">
    <form id="heroSearchForm" class="space-y-2">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
        <div class="flex items-center gap-2.5 flex-1 px-3 py-1.5">
          <svg class="w-4 h-4 text-[#71717A] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z" />
          </svg>
          <input
            id="heroQ1"
            type="text"
            autocomplete="off"
            placeholder="Ürün veya karşılaştırma ara: Z Fold 8, Roborock S8, Liberty 4 NC..."
            class="w-full bg-transparent text-[#111111] placeholder-[#71717A] text-sm font-medium focus:outline-none"
          />
        </div>

        <div class="flex items-center gap-2 px-1 sm:px-0">
          <button
            id="heroVsToggle"
            type="button"
            class="btn-pill btn-pill-outline !py-2 !px-3.5 !text-xs font-mono"
          >
            ⚖ VS Modu
          </button>
          <button
            type="submit"
            class="btn-pill btn-pill-primary !py-2 !px-5 !text-xs"
          >
            AI Analiz <span class="arrow">↗</span>
          </button>
        </div>
      </div>

      <div id="heroVsWrap" class="hidden pt-2 border-t border-[#E4E4E7] px-3 pb-1">
        <input
          id="heroQ2"
          type="text"
          autocomplete="off"
          placeholder="Karşılaştırılacak 2. Ürün (Örn: Apple iPhone Duo, Dreame L10s Ultra...)"
          class="w-full bg-[#F9FAFB] border border-[#E4E4E7] rounded-full text-[#111111] placeholder-[#71717A] px-4 py-2 text-sm focus:border-[#0251A0] focus:outline-none"
        />
      </div>
    </form>
  </div>

  <!-- Verified Match Dropdown -->
  <div
    id="heroSuggestions"
    class="hidden absolute left-0 right-0 top-full mt-2 z-30 bg-white border border-[#D4D4D8] rounded-2xl shadow-xl overflow-hidden divide-y divide-[#E4E4E7]"
  ></div>
</div>

<script define:vars={{ searchIndex }}>
  const q1 = document.getElementById('heroQ1');
  const q2 = document.getElementById('heroQ2');
  const vsBtn = document.getElementById('heroVsToggle');
  const vsWrap = document.getElementById('heroVsWrap');
  const form = document.getElementById('heroSearchForm');
  const suggBox = document.getElementById('heroSuggestions');
  let isVs = false;

  vsBtn?.addEventListener('click', () => {
    isVs = !isVs;
    vsWrap?.classList.toggle('hidden', !isVs);
    if (vsBtn) {
      vsBtn.textContent = isVs ? '✕ VS Kapat' : '⚖ VS Modu';
      vsBtn.classList.toggle('!bg-[#EBF3FC]', isVs);
      vsBtn.classList.toggle('!text-[#02458A]', isVs);
      vsBtn.classList.toggle('!border-[#BDD6F2]', isVs);
    }
    if (isVs) q2?.focus();
  });

  q1?.addEventListener('input', () => {
    const val = q1.value.trim().toLowerCase();
    if (!val || val.length < 2) {
      suggBox?.classList.add('hidden');
      return;
    }
    const matches = searchIndex.filter((item) => item.keywords.includes(val)).slice(0, 4);
    if (matches.length === 0) {
      suggBox?.classList.add('hidden');
      return;
    }
    if (suggBox) {
      suggBox.innerHTML = matches
        .map(
          (m) => `
        <a href="${m.href}" class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-[#F9FAFB] transition">
          <div>
            <div class="text-[10px] font-mono font-semibold uppercase text-[#02458A]">${m.type === 'vs' ? 'DOĞRULANMIŞ HEG VS' : 'DOĞRULANMIŞ HEG İNCELEMESİ'}</div>
            <div class="text-sm font-semibold text-[#111111]">${m.title}</div>
            <div class="text-xs text-[#71717A]">${m.subtitle}</div>
          </div>
          <span class="badge-pill badge-deal font-mono shrink-0">${m.score}</span>
        </a>`
        )
        .join('');
      suggBox.classList.remove('hidden');
    }
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('hegHeroSearch')?.contains(e.target)) {
      suggBox?.classList.add('hidden');
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v1 = q1?.value.trim() || '';
    const v2 = q2?.value.trim() || '';
    if (!v1) {
      q1?.focus();
      return;
    }
    if (isVs && v2) {
      window.location.href = `/asistan?vs=1&q1=${encodeURIComponent(v1)}&q2=${encodeURIComponent(v2)}`;
    } else {
      window.location.href = `/asistan?ara=${encodeURIComponent(v1)}`;
    }
  });
</script>
