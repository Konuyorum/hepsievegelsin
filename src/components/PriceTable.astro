---
import type { StoreOffer } from '../lib/types';
import { formatTRY } from '../data/site';

interface Props {
  productName: string;
  displayDate: string;
  offers: StoreOffer[];
  hasAffiliateLinks: boolean;
}

const { productName, displayDate, offers, hasAffiliateLinks } = Astro.props;
---

<section class="tactile-card overflow-hidden" aria-label={`${productName} Çoklu Mağaza Fiyat Karşılaştırması`}>
  <div class="px-6 py-4 border-b border-[#E4E4E7] flex flex-wrap items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="text-sm font-semibold text-[#111111]">{productName} — Canlı Türkiye Fiyatları</span>
        <span class="badge-pill badge-neutral font-mono">📅 {displayDate}</span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      {hasAffiliateLinks ? (
        <span class="badge-pill badge-neutral font-mono" title="Bazı bağlantılar satış ortaklığı içerebilir; sizin için fiyat değişmez.">
          #reklam · Satış Ortaklığı İçerebilir
        </span>
      ) : (
        <span class="badge-pill badge-blue font-mono">
          Komisyonsuz Doğrudan Link
        </span>
      )}
    </div>
  </div>

  <!-- Semantic HTML Table (Swiss Minimal + GEO/LLM Optimal) -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-[#F9FAFB] border-b border-[#E4E4E7] text-[11px] font-mono uppercase tracking-[0.04em] text-[#71717A]">
          <th class="py-3 px-6 font-semibold">Mağaza & Satıcı</th>
          <th class="py-3 px-4 font-semibold">Not / Durum</th>
          <th class="py-3 px-4 text-right font-semibold">Güncel Fiyat</th>
          <th class="py-3 px-6 text-right font-semibold">Aksiyon</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#E4E4E7] text-[13.5px]">
        {offers.map((offer) => (
          <tr class={offer.isLowest ? 'bg-[#FFFDF0] hover:bg-[#FEF9DC]/70 transition' : 'hover:bg-[#F9FAFB] transition'}>
            <td class="py-3.5 px-6">
              <div class="flex items-center gap-2 flex-wrap">
                <strong class="text-[#111111] font-semibold">{offer.store}</strong>
                {offer.isLowest && (
                  <span class="badge-pill badge-deal font-mono">DİP FİYAT</span>
                )}
                {offer.isAffiliate && (
                  <span class="text-[10px] font-mono text-[#71717A] bg-[#F4F4F5] border border-[#E4E4E7] px-1.5 py-0.5 rounded-full">
                    #reklam
                  </span>
                )}
              </div>
              {offer.seller && <div class="text-xs text-[#71717A] mt-0.5">{offer.seller}</div>}
            </td>

            <td class="py-3.5 px-4 text-xs text-[#52525B]">
              {offer.note || (offer.inStock ? 'Stokta Mevcut' : 'Stok Kontrol Ediniz')}
            </td>

            <td class="py-3.5 px-4 text-right font-mono tabular-nums whitespace-nowrap">
              {offer.oldPrice && offer.oldPrice > offer.price && (
                <div class="text-xs text-[#71717A] line-through">
                  {formatTRY(offer.oldPrice)}
                </div>
              )}
              <div class="font-bold text-[16px] text-[#111111]">
                {formatTRY(offer.price)}
              </div>
            </td>

            <td class="py-3.5 px-6 text-right whitespace-nowrap">
              <a
                href={`/git/${offer.redirectSlug}`}
                target="_blank"
                rel={offer.isAffiliate ? 'nofollow sponsored noopener noreferrer' : 'noopener noreferrer'}
                class={offer.isLowest ? 'btn-pill btn-pill-primary !py-2 !px-4 !text-xs' : 'btn-pill btn-pill-outline !py-2 !px-4 !text-xs'}
              >
                Fırsata Git <span class="arrow">↗</span>
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="px-6 py-3 bg-[#F9FAFB] border-t border-[#E4E4E7] text-[11px] text-[#71717A] flex flex-wrap items-center justify-between gap-2">
    <span>* Fiyatlar {displayDate} itibarıyla canlı kontrol edilmiştir; satıcı stokları anlık değişebilir.</span>
    <span class="font-mono">/git/ ölmeyen yönlendirme korumalı</span>
  </div>
</section>
