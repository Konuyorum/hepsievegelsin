---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  activeNav?: 'home' | 'vs' | 'urunler' | 'katalog' | 'asistan' | 'metodoloji';
}

const {
  title,
  description = SITE.description,
  image = '/images/heg-banner-dark.jpg',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  jsonLd,
  activeNav,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE.url).toString();
const ogImageUrl = new URL(image, SITE.url).toString();
const fullTitle = title.includes('HEG') || title.includes('hepsievegelsin')
  ? title
  : `${title} | hepsievegelsin.com`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  alternateName: ['HEG', 'Hepsi Eve Gelsin', 'hepsievegelsin'],
  url: SITE.url,
  logo: new URL('/images/heg-logo.png', SITE.url).toString(),
  description: SITE.description,
  email: SITE.email,
  sameAs: [SITE.social.youtubeUrl, SITE.social.instagramUrl],
  publishingPrinciples: new URL('/metodoloji', SITE.url).toString(),
};

const schemas = Array.isArray(jsonLd)
  ? [organizationSchema, ...jsonLd]
  : jsonLd
    ? [organizationSchema, jsonLd]
    : [organizationSchema];

const navLinks = [
  { href: '/', label: 'Radar', key: 'home' },
  { href: '/vs', label: 'Karşılaştırmalar', key: 'vs' },
  { href: '/urunler', label: 'İncelemeler', key: 'urunler' },
  { href: '/katalog', label: 'Katalog', key: 'katalog' },
  { href: '/asistan', label: 'AI Asistan', key: 'asistan' },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/heg-logo.png" />
    <link rel="alternate" type="application/rss+xml" title="HEG — Hepsi Eve Gelsin RSS" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="HEG AI & LLM Index" href="/llms.txt" />

    <!-- OpenGraph & Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Tactile Minimalism Typography: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data for Google SEO & AI Search Engines (GEO) -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="flex flex-col min-h-screen bg-[#F4F4F5] text-[#111111] selection:bg-[#FBD101] selection:text-[#1A1500]">
    <!-- Minimal Sticky Topbar (Tactile Deal Radar) -->
    <header class="sticky top-0 z-40 bg-[#F4F4F5]/85 backdrop-blur-md border-b border-[#E4E4E7]">
      <div class="max-w-[1240px] mx-auto px-5 h-[68px] flex items-center justify-between gap-4">
        <!-- Left: Official Logo + Clean Wordmark + Pulsing HEG Yellow Live Dot -->
        <a href="/" class="flex items-center gap-2.5 text-[#111111] font-bold text-[18px] tracking-[-0.03em] shrink-0 group">
          <img
            src="/images/heg-logo.png"
            alt="HEG — Hepsi Eve Gelsin"
            width="36"
            height="36"
            class="w-9 h-9 rounded-[10px] object-cover border border-[#27272A] shadow-sm group-hover:scale-[1.03] transition"
          />
          <span>hepsievegelsin</span>
          <span class="live-dot" title="Canlı Fırsat & Analiz Radarı Aktif"></span>
        </a>

        <!-- Center: Segmented Pill Navigation -->
        <nav aria-label="Ana menü" class="segmented hidden lg:inline-flex">
          {navLinks.map((item) => (
            <a href={item.href} class={activeNav === item.key ? 'active' : ''}>
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Right: Clean Social Pill Links (Micro colored dots, never heavy blocks) -->
        <div class="flex items-center gap-2">
          <a
            href={SITE.social.youtubeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pill btn-pill-outline !py-1.5 !px-3 !text-xs"
            title="YouTube @hepsievegelsin"
          >
            <span class="w-[7px] h-[7px] rounded-full bg-[#FF0000] inline-block"></span>
            <span class="hidden sm:inline">YouTube</span>
          </a>
          <a
            href={SITE.social.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pill btn-pill-outline !py-1.5 !px-3 !text-xs"
            title="Instagram @hepsievegelsin"
          >
            <span class="w-[7px] h-[7px] rounded-full bg-[#E1306C] inline-block"></span>
            <span class="hidden sm:inline">Instagram</span>
          </a>

          <button
            id="mobileMenuBtn"
            type="button"
            aria-label="Menüyü Aç"
            class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-full bg-white border border-[#E4E4E7] text-[#111111]"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Drawer -->
      <div id="mobileMenu" class="hidden lg:hidden bg-white border-t border-[#E4E4E7] px-5 py-3 space-y-1">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class={`block px-4 py-2.5 rounded-full text-sm font-medium ${
              activeNav === item.key
                ? 'bg-[#EBF3FC] text-[#02458A] font-semibold'
                : 'text-[#52525B] hover:bg-[#F4F4F5]'
            }`}
          >
            {item.label}
          </a>
        ))}
        <a href="/metodoloji" class="block px-4 py-2.5 rounded-full text-sm text-[#52525B] hover:bg-[#F4F4F5]">
          Tarafsızlık & Metodoloji
        </a>
      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Minimal Airy Swiss Footer -->
    <footer class="max-w-[1240px] w-full mx-auto px-5 pt-10 pb-12 mt-14 border-t border-[#E4E4E7]">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-[#E4E4E7]">
        <div class="flex items-center gap-2.5">
          <img src="/images/heg-logo.png" alt="HEG Logo" class="w-7 h-7 rounded-lg border border-[#27272A]" />
          <div>
            <span class="font-bold text-sm text-[#111111]">hepsievegelsin.com</span>
            <span class="text-xs text-[#71717A] ml-2 hidden sm:inline">Gerçek İndirim · Tarafsız Analiz · Alınır mı?</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-[#52525B]">
          <a href="/vs" class="hover:text-[#0251A0] transition">Karşılaştırmalar</a>
          <a href="/urunler" class="hover:text-[#0251A0] transition">Derecelendirmeler</a>
          <a href="/katalog" class="hover:text-[#0251A0] transition">Akıllı Katalog</a>
          <a href="/metodoloji" class="hover:text-[#0251A0] transition">Tarafsızlık & Metodoloji</a>
          <a href="/kvkk" class="hover:text-[#0251A0] transition">KVKK & Gizlilik</a>
          <a href="/llms.txt" class="font-mono text-[11px] text-[#71717A] hover:text-[#111111] transition">/llms.txt</a>
          <a href="/rss.xml" class="font-mono text-[11px] text-[#71717A] hover:text-[#111111] transition">/rss.xml</a>
        </div>
      </div>

      <div class="pt-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[11.5px] text-[#71717A] leading-relaxed">
        <p class="max-w-3xl">
          <strong class="text-[#52525B]">Şeffaflık & Reklam Kurulu Bildirimi:</strong> Hiçbir inceleme veya puan marka sponsorluğu ile belirlenmez. Bazı mağaza yönlendirmeleri satış ortaklığı (<span class="font-mono text-[#111111]">#reklam</span>) içerebilir; sizin için ürün fiyatı değişmez. Fiyatlar <span class="font-mono">{SITE.lastUpdated}</span> itibarıyla kontrol edilmiştir.
        </p>
        <div class="font-mono text-[11px] shrink-0">
          © 2026 hepsievegelsin.com · <a href={`mailto:${SITE.email}`} class="underline hover:text-[#111111]">{SITE.email}</a>
        </div>
      </div>
    </footer>

    <!-- Shared Tactile Toast -->
    <div
      id="hegToast"
      class="fixed bottom-6 right-6 bg-[#111111] text-white px-4 py-3 rounded-full text-[13px] font-medium flex items-center gap-2.5 shadow-xl translate-y-24 opacity-0 transition-all duration-200 z-50 pointer-events-none"
    >
      <span class="live-dot"></span>
      <span id="hegToastText">Kaydedildi</span>
    </div>

    <script>
      const btn = document.getElementById('mobileMenuBtn');
      const menu = document.getElementById('mobileMenu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

      let toastTimer: number | undefined;
      (window as any).showHegToast = (msg: string) => {
        const el = document.getElementById('hegToast');
        const txt = document.getElementById('hegToastText');
        if (!el || !txt) return;
        txt.textContent = msg;
        el.classList.remove('translate-y-24', 'opacity-0');
        el.classList.add('translate-y-0', 'opacity-100');
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          el.classList.add('translate-y-24', 'opacity-0');
          el.classList.remove('translate-y-0', 'opacity-100');
        }, 2500);
      };
    </script>
  </body>
</html>
