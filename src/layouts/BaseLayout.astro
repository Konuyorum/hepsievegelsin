---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  activeNav?: 'home' | 'vs' | 'urunler' | 'katalog' | 'asistan' | 'metodoloji';
}

const {
  title,
  description = SITE.description,
  image = '/images/heg-banner-dark.jpg',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  jsonLd,
  activeNav,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE.url).toString();
const ogImageUrl = new URL(image, SITE.url).toString();
const fullTitle = title.includes('HEG') ? title : `${title} | HEG — Hepsi Eve Gelsin`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  alternateName: ['HEG', 'Hepsi Eve Gelsin'],
  url: SITE.url,
  logo: new URL('/images/heg-logo.png', SITE.url).toString(),
  description: SITE.description,
  email: SITE.email,
  sameAs: [SITE.social.youtubeUrl, SITE.social.instagramUrl],
  publishingPrinciples: new URL('/metodoloji', SITE.url).toString(),
};

const schemas = Array.isArray(jsonLd)
  ? [organizationSchema, ...jsonLd]
  : jsonLd
    ? [organizationSchema, jsonLd]
    : [organizationSchema];

const navLinks = [
  { href: '/vs', label: 'HEG VS', key: 'vs' },
  { href: '/urunler', label: 'Ürün Derecelendirme', key: 'urunler' },
  { href: '/katalog', label: 'Akıllı Katalog', key: 'katalog' },
  { href: '/asistan', label: 'AI Asistan', key: 'asistan' },
  { href: '/metodoloji', label: 'Tarafsızlık & Metodoloji', key: 'metodoloji' },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/heg-logo.png" />
    <link rel="alternate" type="application/rss+xml" title="HEG — Hepsi Eve Gelsin RSS" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="HEG AI & LLM Index" href="/llms.txt" />

    <!-- OpenGraph & Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Editorial Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data for Google SEO & AI Search Engines (GEO) -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="flex flex-col min-h-screen text-[#0B0B0D] selection:bg-[#FAD002] selection:text-[#0B0B0D]">
    <!-- Top Institutional Transparency Strip -->
    <div class="bg-[#070B14] text-slate-300 border-b border-white/10 text-[11px] font-mono tracking-wide">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-3 flex-wrap">
          <span class="inline-flex items-center gap-1.5 text-emerald-400 font-bold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            BAĞIMSIZ VERİ PLATFORMU
          </span>
          <span class="text-slate-600 hidden sm:inline">|</span>
          <span class="hidden sm:inline text-slate-400">MARKA SPONSORLUĞU YOK • GERÇEK İNDİRİM DENETİMİ</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[#FAD002] font-bold">GÜNCEL TARAMA: {SITE.lastUpdated.toUpperCase()}</span>
          <a href="/llms.txt" class="hidden md:inline text-slate-400 hover:text-white transition" title="Yapay Zeka Motorları İçin Yapılandırılmış İndeks">
            /llms.txt
          </a>
        </div>
      </div>
    </div>

    <!-- Main Sticky Navbar -->
    <header class="sticky top-0 z-40 bg-[#0B1120]/95 backdrop-blur-md border-b border-white/10 shadow-lg shadow-slate-950/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="h-18 flex items-center justify-between gap-4">
          <!-- Brand Logo -->
          <a href="/" class="flex items-center gap-3 group shrink-0">
            <img
              src="/images/heg-logo.png"
              alt="HEG — Hepsi Eve Gelsin Logosu"
              width="42"
              height="42"
              class="w-10 h-10 rounded-xl object-cover ring-1 ring-white/15 group-hover:ring-[#FAD002]/70 transition"
            />
            <div class="leading-none">
              <div class="flex items-center gap-2">
                <span class="text-white font-extrabold text-xl tracking-tight">HEG</span>
                <span class="hidden sm:inline-block text-[10px] font-mono uppercase tracking-[0.18em] text-[#FAD002] bg-[#FAD002]/10 border border-[#FAD002]/25 px-1.5 py-0.5 rounded">
                  v2.0
                </span>
              </div>
              <span class="block text-[11px] font-semibold tracking-wider text-slate-400 mt-0.5">
                HEPSİ EVE GELSİN
              </span>
            </div>
          </a>

          <!-- Desktop Nav -->
          <nav aria-label="Ana Navigasyon" class="hidden lg:flex items-center gap-1">
            {navLinks.map((item) => {
              const isActive = activeNav === item.key;
              return (
                <a
                  href={item.href}
                  class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition ${
                    isActive
                      ? 'bg-[#03519F] text-white shadow-sm shadow-[#03519F]/40'
                      : 'text-slate-300 hover:text-white hover:bg-white/5'
                  }`}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <!-- Right Social & Mobile Toggle -->
          <div class="flex items-center gap-2.5">
            <a
              href={SITE.social.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white text-xs font-bold px-3.5 py-2 rounded-lg transition shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z" />
              </svg>
              <span class="hidden sm:inline">@hepsievegelsin</span>
              <span class="sm:hidden">YouTube</span>
            </a>

            <a
              href={SITE.social.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="HEG Instagram"
              class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 hover:bg-white/15 border border-white/10 text-slate-200 hover:text-[#FAD002] transition"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.3.1 1.3.1 1.6.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.3.4-1.3.1-1.6.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.9-.2-2.3-.4a3.9 3.9 0 0 1-1.4-.9c-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.3-.1-1.3-.1-1.6-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.3-.4 1.3-.1 1.6-.1 4.9-.1zm0-2.2C8.7 0 8.3 0 7 .1 5.7.1 4.8.3 4.1.6c-.8.3-1.4.7-2.1 1.4A5.9 5.9 0 0 0 .6 4.1C.3 4.8.1 5.7.1 7 0 8.3 0 8.7 0 12s0 3.7.1 5c.1 1.3.3 2.2.6 2.9.3.8.7 1.4 1.4 2.1.7.7 1.3 1.1 2.1 1.4.7.3 1.6.5 2.9.6 1.3.1 1.7.1 5 .1s3.7 0 5-.1c1.3-.1 2.2-.3 2.9-.6.8-.3 1.4-.7 2.1-1.4.7-.7 1.1-1.3 1.4-2.1.3-.7.5-1.6.6-2.9.1-1.3.1-1.7.1-5s0-3.7-.1-5c-.1-1.3-.3-2.2-.6-2.9a5.9 5.9 0 0 0-1.4-2.1A5.9 5.9 0 0 0 19.9.6C19.2.3 18.3.1 17 .1 15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z" />
              </svg>
            </a>

            <button
              id="mobileMenuBtn"
              type="button"
              aria-label="Menüyü Aç"
              class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 border border-white/10 text-white"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Thin Signature Blue-Yellow Architectural Stripe -->
      <div class="h-[3px] w-full heg-stripe"></div>

      <!-- Mobile Menu Drawer -->
      <div id="mobileMenu" class="hidden lg:hidden bg-[#0B1120] border-t border-white/10 px-4 py-4 space-y-1.5">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class={`block px-4 py-2.5 rounded-lg text-sm font-semibold ${
              activeNav === item.key ? 'bg-[#03519F] text-white' : 'text-slate-300 hover:bg-white/5'
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Editorial Footer -->
    <footer class="bg-[#070B14] text-slate-300 border-t border-white/10 mt-20">
      <div class="h-1 w-full heg-stripe"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-white/10">
          <!-- Brand Column -->
          <div class="md:col-span-5 space-y-4">
            <div class="flex items-center gap-3">
              <img src="/images/heg-logo.png" alt="HEG Logo" class="w-11 h-11 rounded-xl ring-1 ring-white/15" />
              <div>
                <div class="text-white font-extrabold text-xl tracking-tight">HEPSİ EVE GELSİN</div>
                <div class="text-[11px] font-mono text-[#FAD002] tracking-widest">{SITE.tagline}</div>
              </div>
            </div>
            <p class="text-sm text-slate-400 leading-relaxed max-w-md">
              Hiçbir markanın sponsorluğunu almadan; canlı çoklu mağaza fiyatları, teknik kıyaslamalar ve binlerce gerçek kullanıcı yorumuyla tarafsız kararlar üretiyoruz. Gerektiğinde açıkça <strong class="text-white">"Alınmaz"</strong> diyoruz.
            </p>
            <div class="flex flex-wrap gap-2.5 pt-1">
              <a
                href={SITE.social.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-bold bg-white/5 hover:bg-red-600 text-white px-3.5 py-2 rounded-lg border border-white/10 transition"
              >
                YouTube {SITE.social.youtubeHandle}
              </a>
              <a
                href={SITE.social.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-bold bg-white/5 hover:bg-[#03519F] text-white px-3.5 py-2 rounded-lg border border-white/10 transition"
              >
                Instagram {SITE.social.instagramHandle}
              </a>
            </div>
          </div>

          <!-- Content Links -->
          <div class="md:col-span-3 space-y-3">
            <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-400">Platform</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/vs" class="hover:text-[#FAD002] transition">HEG VS Karşılaştırmalar</a></li>
              <li><a href="/urunler" class="hover:text-[#FAD002] transition">Bağımsız Ürün Derecelendirme</a></li>
              <li><a href="/katalog" class="hover:text-[#FAD002] transition">Akıllı Katalog Elemesi</a></li>
              <li><a href="/asistan" class="hover:text-[#FAD002] transition">HEG AI Alışveriş Asistanı</a></li>
            </ul>
          </div>

          <!-- Transparency & GEO Links -->
          <div class="md:col-span-4 space-y-3">
            <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-400">Şeffaflık, Yasal & Veri</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/metodoloji" class="hover:text-[#FAD002] transition">Tarafsızlık Manifestosu & Puanlama Metodolojisi</a></li>
              <li><a href="/kvkk" class="hover:text-[#FAD002] transition">KVKK, Gizlilik & Reklam Kurulu Şeffaflığı</a></li>
              <li><a href="/llms.txt" class="hover:text-[#FAD002] transition font-mono text-xs">Yapay Zeka Kaynak İndeksi (/llms.txt)</a></li>
              <li><a href="/rss.xml" class="hover:text-[#FAD002] transition font-mono text-xs">RSS Veri Akışı (/rss.xml)</a></li>
              <li class="text-xs text-slate-400 pt-1">İletişim: <a href={`mailto:${SITE.email}`} class="text-slate-200 underline decoration-slate-600 hover:text-[#FAD002]">{SITE.email}</a></li>
            </ul>
          </div>
        </div>

        <!-- Legal & Reklam Kurulu Disclosure -->
        <div class="pt-6 space-y-3 text-xs text-slate-500 leading-relaxed">
          <p>
            <strong class="text-slate-300">Yasal Bilgilendirme & Reklam Kurulu Şeffaflığı:</strong> Sitemizdeki hiçbir ürün incelemesi, puanı veya "Kesin Alınır / Alınmaz" kararı marka sponsorluğu ile belirlenmez. Ancak bazı mağaza yönlendirme bağlantıları (ör. Amazon TR Gelir Ortaklığı) satış ortaklığı (affiliate) kapsamında olabileceğinden Türkiye Ticaret Bakanlığı mevzuatı gereği <span class="text-[#FAD002] font-mono">#reklam #işbirliği</span> etiketiyle işaretlenmektedir. Bu bağlantılardan alışveriş yaptığınızda sizin için ürün fiyatı değişmez; HEG'in bağımsız analiz altyapısına destek olursunuz. Fiyatlar ve stok durumları anlık değişebilir.
          </p>
          <div class="flex flex-wrap items-center justify-between gap-2 pt-2 text-[11px] font-mono text-slate-600">
            <span>© 2026 Hepsi Eve Gelsin (hepsievegelsin.com). Tüm hakları saklıdır.</span>
            <span>HEG Nordic–Italian Editorial System</span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobileMenuBtn');
      const menu = document.getElementById('mobileMenu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
