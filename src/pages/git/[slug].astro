---
import links from '../../data/links.json';

type LinkEntry = {
  url: string;
  store: string;
  product: string;
  isAffiliate: boolean;
};

export function getStaticPaths() {
  const map = links as Record<string, LinkEntry>;
  return Object.entries(map).map(([slug, entry]) => ({
    params: { slug },
    props: { entry, slug },
  }));
}

const { entry } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`1;url=${entry.url}`} />
    <title>{entry.product} — {entry.store} Yönlendiriliyor | HEG</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0b1120;
        color: #f8fafc;
        font-family: system-ui, -apple-system, sans-serif;
        padding: 1.5rem;
      }
      .card {
        max-width: 460px;
        width: 100%;
        background: #111827;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        padding: 2rem;
        text-align: center;
      }
      .badge {
        display: inline-block;
        font-size: 11px;
        font-family: monospace;
        background: rgba(250, 208, 2, 0.15);
        color: #fad002;
        border: 1px solid rgba(250, 208, 2, 0.35);
        padding: 4px 10px;
        border-radius: 8px;
        margin-bottom: 14px;
      }
      a.btn {
        display: inline-block;
        margin-top: 18px;
        background: #03519f;
        color: #fff;
        text-decoration: none;
        font-weight: 700;
        padding: 12px 22px;
        border-radius: 12px;
      }
      p { color: #94a3b8; font-size: 13px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="badge">
        {entry.isAffiliate ? '#reklam • Satış Ortaklığı Bağlantısı' : 'HEG Doğrudan Mağaza Bağlantısı'}
      </div>
      <h1 style="font-size: 20px; margin: 0 0 8px;">{entry.store} sayfasına yönlendiriliyorsunuz</h1>
      <p><strong>{entry.product}</strong> — Fiyatınız değişmez, güncel stok ve kampanyayı mağazada kontrol edebilirsiniz.</p>
      <a class="btn" href={entry.url} rel={entry.isAffiliate ? 'nofollow sponsored noopener noreferrer' : 'noopener noreferrer'}>
        Hemen Mağazaya Git ↗
      </a>
    </div>
  </body>
</html>
