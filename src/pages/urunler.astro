---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAllProducts } from '../lib/content';
import { SITE } from '../data/site';

const products = getAllProducts();
const categories = [...new Set(products.map((p) => p.category))];

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'HEG Bağımsız Ürün Derecelendirme ve Fırsat Dizini',
  numberOfItems: products.length,
  itemListElement: products.map((p, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: p.name,
    url: `${SITE.url}/urun/${p.slug}`,
  })),
};
---

<BaseLayout
  title="Bağımsız Ürün Derecelendirme & Canlı Fırsatlar"
  description="YouTube videolarımız ve web platformumuza özel, marka sponsorluğu olmadan 5 kriterle puanlanmış tüm ürün incelemeleri, çoklu mağaza fiyatları ve sahte indirim uyarıları."
  canonicalPath="/urunler"
  activeNav="urunler"
  jsonLd={listSchema}
>
  <div class="max-w-[1240px] mx-auto px-5 py-8 space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="badge-pill badge-blue font-mono">BAĞIMSIZ DERECELENDİRME MERKEZİ</span>
          <span class="font-mono text-[11px] text-[#71717A]">{categories.join(' · ')}</span>
        </div>
        <h1 class="text-[28px] sm:text-[34px] font-semibold tracking-[-0.03em] text-[#111111]">
          HEG Puanlı İncelemeler & Gerçek Fırsatlar
        </h1>
        <p class="text-[14px] text-[#52525B] mt-1 max-w-2xl">
          Yalnızca YouTube kanalımızdaki videolar değil — web sitemize özel bağımsız 5 kriterli derecelendirmeler ve sahte indirim denetimleri.
        </p>
      </div>
      <span id="visibleCount" class="font-mono text-xs text-[#71717A]">Gösterilen: {products.length} ürün</span>
    </div>

    <div class="segmented overflow-x-auto max-w-full" id="verdictFilters">
      <button data-filter="ALL" type="button" class="active">Tümü ({products.length})</button>
      <button data-filter="KESIN_ALINIR" type="button">Kesin Alınır</button>
      <button data-filter="FP_SAMPIYONU" type="button">En İyi F/P</button>
      <button data-filter="SARTLI_ALINIR" type="button">Şartlı Alınır</button>
      <button data-filter="ALINMAZ" type="button">⚠ Alınmaz</button>
      <button data-filter="WEB_ONLY" type="button">Sadece Web</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[18px]" id="productGrid">
      {products.map((product) => (
        <div
          class="product-item"
          data-verdict={product.verdict}
          data-web-only={product.social?.youtubeUrl ? 'false' : 'true'}
        >
          <ProductCard product={product} />
        </div>
      ))}
    </div>
  </div>

  <script>
    const btns = document.querySelectorAll('#verdictFilters button');
    const items = document.querySelectorAll('.product-item');
    const countEl = document.getElementById('visibleCount');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'ALL';
        btns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        let count = 0;
        items.forEach((el) => {
          const verdict = el.getAttribute('data-verdict');
          const webOnly = el.getAttribute('data-web-only') === 'true';
          const show = filter === 'ALL' || (filter === 'WEB_ONLY' && webOnly) || verdict === filter;
          el.classList.toggle('hidden', !show);
          if (show) count++;
        });
        if (countEl) countEl.textContent = `Gösterilen: ${count} ürün`;
      });
    });
  </script>
</BaseLayout>
