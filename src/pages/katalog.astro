---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestCatalog } from '../lib/content';
import { formatTRY, CATALOG_STATUS_META, SITE } from '../data/site';

const catalog = getLatestCatalog()!;
const markets = ['Tümü', 'A101', 'BİM', 'ŞOK', 'Migros'] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'HEG Akıllı Katalog Elemesi nedir?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A101, BİM, ŞOK ve Migros haftalık aktüel broşürlerindeki onlarca ürünü tek tek online piyasa taban fiyatlarıyla ve gıda içerik listeleriyle karşılaştırarak yalnızca gerçek fırsatları ve online alternatifi daha ucuz olanları ayıklayan bağımsız analizdir.',
      },
    },
  ],
};
---

<BaseLayout
  title={`${catalog.title} — A101, BİM, ŞOK, Migros Fiyat Denetimi`}
  description={catalog.summary}
  canonicalPath="/katalog"
  activeNav="katalog"
  jsonLd={faqSchema}
>
  <div class="max-w-[1240px] mx-auto px-5 py-8 space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="badge-pill badge-deal font-mono">{catalog.weekLabel}</span>
          <span class="font-mono text-[11px] text-[#71717A]">📅 SON KONTROL: {catalog.displayDate}</span>
        </div>
        <h1 class="text-[28px] sm:text-[34px] font-semibold tracking-[-0.03em] text-[#111111]">
          HEG Akıllı Katalog Elemesi
        </h1>
        <p class="text-[14px] text-[#52525B] mt-1 max-w-3xl leading-relaxed">
          {catalog.summary}
        </p>
      </div>

      <div class="segmented overflow-x-auto max-w-full" id="marketFilters">
        {markets.map((m, idx) => (
          <button data-market={m} type="button" class={idx === 0 ? 'active' : ''}>
            {m}
          </button>
        ))}
      </div>
    </div>

    <!-- Tactile Comparison Table -->
    <section class="tactile-card overflow-hidden">
      <div class="px-6 py-4 border-b border-[#E4E4E7] flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-[15px] font-semibold text-[#111111]">
          Market Fiyatı vs. Online Piyasa Tabanı (<span id="catalogCountLabel">{catalog.items.length} Elenmiş Ürün</span>)
        </h2>
        <span class="font-mono text-[11px] text-[#71717A]">Bağlantılarda #reklam (affiliate) bulunabilir</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-[13.5px]">
          <thead>
            <tr class="bg-[#F9FAFB] border-b border-[#E4E4E7] text-[11px] font-mono uppercase tracking-[0.04em] text-[#71717A]">
              <th class="py-3 px-5 font-semibold">Market & Tarih</th>
              <th class="py-3 px-4 font-semibold">Ürün & HEG Uzman Notu</th>
              <th class="py-3 px-4 text-right font-semibold">Market Fiyatı</th>
              <th class="py-3 px-4 text-right font-semibold">Online Taban</th>
              <th class="py-3 px-5 text-right font-semibold">HEG Durumu</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E4E4E7]" id="catalogTableBody">
            {catalog.items.map((item) => {
              const st = CATALOG_STATUS_META[item.status];
              const diff = item.onlinePrice - item.marketPrice;
              return (
                <tr class="catalog-row hover:bg-[#F9FAFB] transition align-top" data-market={item.market}>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="font-mono font-bold text-xs bg-[#F4F4F5] border border-[#E4E4E7] text-[#111111] px-2.5 py-0.5 rounded-md">
                      {item.market}
                    </span>
                    <div class="text-[11px] font-mono text-[#71717A] mt-1.5">{item.validDates}</div>
                    <div class="text-[11px] text-[#71717A]">{item.category}</div>
                  </td>

                  <td class="py-4 px-4 max-w-md">
                    <div class="font-semibold text-[#111111]">{item.name}</div>
                    <p class="text-xs text-[#52525B] mt-1 leading-relaxed">{item.verdictNote}</p>
                  </td>

                  <td class="py-4 px-4 text-right font-mono font-bold text-[#111111] whitespace-nowrap tabular-nums">
                    {formatTRY(item.marketPrice)}
                  </td>

                  <td class="py-4 px-4 text-right font-mono whitespace-nowrap tabular-nums">
                    <div class="font-semibold text-[#02458A]">{formatTRY(item.onlinePrice)}</div>
                    <div class={`text-[10.5px] font-medium mt-0.5 ${diff > 0 ? 'text-[#111111]' : 'text-[#B91C1C]'}`}>
                      {diff > 0 ? `Market ${formatTRY(diff)} ucuz` : `Online ${formatTRY(Math.abs(diff))} ucuz`}
                    </div>
                  </td>

                  <td class="py-4 px-5 text-right whitespace-nowrap space-y-2">
                    <div>
                      <span class={`badge-pill font-mono ${st.badgeClass}`}>
                        {st.label}
                      </span>
                    </div>
                    {item.redirectSlug && (
                      <div>
                        <a
                          href={`/git/${item.redirectSlug}`}
                          target="_blank"
                          rel={item.isAffiliate ? 'nofollow sponsored noopener noreferrer' : 'noopener noreferrer'}
                          class="btn-pill btn-pill-outline !py-1 !px-3 !text-[11px]"
                        >
                          {item.onlineStore || 'Online Alternatif'} ↗
                        </a>
                      </div>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <div class="tactile-card p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="badge-pill badge-neutral font-mono">HAFTALIK VİDEO ELEMESİ</span>
        <h3 class="text-[16px] font-semibold text-[#111111] mt-2">Katalog Elemelerini YouTube & Instagram'da Takip Edin</h3>
        <p class="text-xs text-[#52525B] mt-0.5">Stoklar tükenmeden haftalık özetler ve 45 saniyelik Shorts uyarıları için kanala katılın.</p>
      </div>
      <div class="flex gap-2 shrink-0">
        <a href={SITE.social.youtubeUrl} target="_blank" rel="noopener noreferrer" class="btn-pill btn-pill-primary !py-2 !px-4 !text-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF0000]"></span>
          YouTube <span class="arrow">↗</span>
        </a>
        <a href={SITE.social.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn-pill btn-pill-outline !py-2 !px-4 !text-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#E1306C]"></span>
          Instagram ↗
        </a>
      </div>
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll('#marketFilters button');
    const rows = document.querySelectorAll('.catalog-row');
    const countLabel = document.getElementById('catalogCountLabel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-market') || 'Tümü';
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        let visible = 0;
        rows.forEach((row) => {
          const market = row.getAttribute('data-market');
          const hide = selected !== 'Tümü' && market !== selected;
          row.classList.toggle('hidden', hide);
          if (!hide) visible++;
        });
        if (countLabel) {
          countLabel.textContent = selected === 'Tümü'
            ? `${visible} Elenmiş Ürün`
            : `${selected}: ${visible} / ${rows.length} Elenmiş Ürün`;
        }
      });
    });
  </script>
</BaseLayout>
