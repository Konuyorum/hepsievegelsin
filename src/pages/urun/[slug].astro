---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import PriceTable from '../../components/PriceTable.astro';
import SocialPresenceCard from '../../components/SocialPresenceCard.astro';
import { getAllProducts } from '../../lib/content';
import { SITE, formatTRY } from '../../data/site';

export function getStaticPaths() {
  const products = getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const canonicalPath = `/urun/${product.slug}`;
const fullUrl = new URL(canonicalPath, SITE.url).toString();
const bestOffer = product.offers.find((o) => o.isLowest) || product.offers[0];

const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  brand: { '@type': 'Brand', name: product.brand },
  category: product.category,
  image: new URL(product.image, SITE.url).toString(),
  description: product.tldr,
  url: fullUrl,
  review: {
    '@type': 'Review',
    name: `${product.name} — HEG Tarafsız İnceleme ve Derecelendirme`,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    datePublished: product.datePublished,
    dateModified: product.dateModified,
    reviewBody: product.tldr,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: product.hegScore,
      bestRating: 10,
      worstRating: 0,
    },
    positiveNotes: {
      '@type': 'ItemList',
      itemListElement: product.pros.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p })),
    },
    negativeNotes: {
      '@type': 'ItemList',
      itemListElement: product.cons.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c })),
    },
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'TRY',
    lowPrice: Math.min(...product.offers.map((o) => o.price)),
    highPrice: Math.max(...product.offers.map((o) => o.price)),
    offerCount: product.offers.length,
    offers: product.offers.map((o) => ({
      '@type': 'Offer',
      seller: { '@type': 'Organization', name: o.store },
      price: o.price,
      priceCurrency: 'TRY',
      availability: o.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: new URL(`/git/${o.redirectSlug}`, SITE.url).toString(),
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'İncelemeler', item: `${SITE.url}/urunler` },
    { '@type': 'ListItem', position: 3, name: product.name, item: fullUrl },
  ],
};
---

<BaseLayout
  title={`${product.name} İnceleme, HEG Puanı (${product.hegScore}/10) ve Canlı Fiyatlar`}
  description={product.tldr}
  image={product.image}
  canonicalPath={canonicalPath}
  ogType="article"
  activeNav="urunler"
  jsonLd={[productSchema, faqSchema, breadcrumbSchema]}
>
  <article class="max-w-[1160px] mx-auto px-5 py-7 space-y-6">
    <!-- Minimal Breadcrumb & Date Strip -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[#71717A]">
        <a href="/" class="hover:text-[#111111]">Radar</a>
        <span>/</span>
        <a href="/urunler" class="hover:text-[#111111]">İncelemeler</a>
        <span>/</span>
        <span class="text-[#111111] font-medium">{product.name}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-pill badge-neutral font-mono">📅 {product.displayDate}</span>
        <span class="badge-pill badge-blue font-mono">%0 SPONSOR · TARAFSIZ ANALİZ</span>
      </div>
    </div>

    <!-- Bento Product Hero -->
    <header class="grid grid-cols-1 lg:grid-cols-12 gap-[18px] items-stretch">
      <!-- Left Photo Bento -->
      <div class="lg:col-span-5 tactile-card p-6 flex flex-col justify-between">
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="font-mono text-[11px] uppercase text-[#71717A]">{product.brand} · {product.category}</span>
          {product.social?.youtubeUrl ? (
            <span class="badge-pill badge-blue font-mono">YOUTUBE + WEB</span>
          ) : (
            <span class="badge-pill badge-neutral font-mono">WEB-ÖZEL ANALİZ</span>
          )}
        </div>

        <div class="bg-[#F9FAFB] border border-[#E4E4E7] rounded-[14px] aspect-[4/3] flex items-center justify-center p-5">
          <img src={product.image} alt={product.name} class="deal-photo max-h-full max-w-full object-contain" />
        </div>

        {product.reviewStats && (
          <div class="mt-4 pt-3.5 border-t border-dashed border-[#E4E4E7] flex items-center justify-between text-xs text-[#52525B]">
            <span>{product.reviewStats.source}</span>
            <strong class="font-mono text-[#111111]">
              ★ {product.reviewStats.rating}/5 ({product.reviewStats.count.toLocaleString('tr-TR')})
            </strong>
          </div>
        )}
      </div>

      <!-- Right Summary & Price Bento -->
      <div class="lg:col-span-7 tactile-card p-6 sm:p-7 flex flex-col justify-between gap-5">
        <div class="space-y-4">
          <VerdictBadge verdict={product.verdict} score={product.hegScore} size="lg" />

          <div>
            <h1 class="text-[26px] sm:text-[34px] font-semibold tracking-[-0.03em] leading-[1.15] text-[#111111]">
              {product.name}
            </h1>
            <p class="text-[14px] text-[#52525B] mt-1">{product.subtitle}</p>
          </div>

          <!-- Answer-First TL;DR Box -->
          <div class="bg-[#F9FAFB] border border-[#E4E4E7] border-l-[3px] border-l-[#0251A0] rounded-r-[14px] p-4">
            <div class="font-mono text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#02458A] mb-1">
              HEG ÖZET KARARI (TL;DR)
            </div>
            <p class="text-[13.5px] text-[#111111] leading-relaxed">{product.tldr}</p>
          </div>

          {product.isFakeDealAlert && product.fakeDealReason && (
            <div class="bg-[#FEF2F2] border border-[#FECACA] rounded-[14px] p-4 text-[13px] text-[#991B1B] leading-relaxed">
              <strong class="font-mono text-[11px] uppercase block mb-1">⚠ SAHTE İNDİRİM / FİYAT UYARISI</strong>
              {product.fakeDealReason}
            </div>
          )}
        </div>

        <!-- Price + Primary Black Pill CTA -->
        <div class="pt-5 border-t border-[#E4E4E7] flex flex-wrap items-end justify-between gap-4">
          <div class="tabular-nums">
            <div class="font-mono text-[11px] text-[#71717A] uppercase">
              {product.isFakeDealAlert ? 'GÜNCEL SATIŞ FİYATI' : 'CANLI EN DİP FİYAT'}
            </div>
            <div class="flex items-baseline gap-2.5 mt-1 font-mono">
              <span class="text-[32px] font-bold tracking-[-0.03em] text-[#111111] leading-none">
                {formatTRY(product.currentLowestPrice)}
              </span>
              {product.listPrice > product.currentLowestPrice && (
                <span class="text-[15px] text-[#71717A] line-through">
                  {formatTRY(product.listPrice)}
                </span>
              )}
              {!product.isFakeDealAlert && product.netSavings > 0 && (
                <span class="badge-pill badge-deal font-mono">
                  -{product.discountPercent}% · {formatTRY(product.netSavings)}
                </span>
              )}
            </div>
            <p class="text-[11.5px] text-[#71717A] mt-1.5">{product.priceNote}</p>
          </div>

          {bestOffer && (
            <a
              href={`/git/${bestOffer.redirectSlug}`}
              target="_blank"
              rel={bestOffer.isAffiliate ? 'nofollow sponsored noopener noreferrer' : 'noopener noreferrer'}
              class="btn-pill btn-pill-primary !py-3 !px-6"
            >
              {bestOffer.store}'da Gör <span class="arrow">↗</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Multi-Store Live Price Table -->
    <PriceTable
      productName={product.name}
      displayDate={product.displayDate}
      offers={product.offers}
      hasAffiliateLinks={product.hasAffiliateLinks}
    />

    <!-- 5-Criteria Sparkline ScoreCard -->
    <ScoreCard
      score={product.hegScore}
      verdict={product.verdict}
      criteria={product.criteria}
      verdictHeadline={product.verdictHeadline}
    />

    <!-- Pros & Cons Bento -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-[18px]">
      <div class="tactile-card p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-[16px] font-semibold text-[#111111]">Güçlü Yönleri (Artılar)</h2>
          <span class="badge-pill badge-deal font-mono">✓ ARTI</span>
        </div>
        <ul class="space-y-2.5 text-[13.5px] text-[#52525B]">
          {product.pros.map((pro) => (
            <li class="flex items-start gap-2.5 leading-relaxed">
              <span class="font-mono font-bold text-[#111111] mt-0.5">+</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
        <div class="pt-3.5 border-t border-dashed border-[#E4E4E7] text-xs text-[#52525B] bg-[#F9FAFB] rounded-[12px] p-3.5">
          <strong class="text-[#111111] block mb-1">Kimler Almalı?</strong>
          {product.whoShouldBuy}
        </div>
      </div>

      <div class="tactile-card p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-[16px] font-semibold text-[#111111]">Kritik Eksiler & Gerçek Şikayetler</h2>
          <span class="badge-pill badge-hot font-mono">✕ EKSİ</span>
        </div>
        <ul class="space-y-2.5 text-[13.5px] text-[#52525B]">
          {product.cons.map((con) => (
            <li class="flex items-start gap-2.5 leading-relaxed">
              <span class="font-mono font-bold text-[#EF4444] mt-0.5">−</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
        <div class="pt-3.5 border-t border-dashed border-[#E4E4E7] text-xs text-[#52525B] bg-[#FEF2F2]/60 rounded-[12px] p-3.5">
          <strong class="text-[#991B1B] block mb-1">Kimler Uzak Durmalı?</strong>
          {product.whoShouldSkip}
        </div>
      </div>
    </section>

    <!-- Technical Specs Semantic Table -->
    <section class="tactile-card overflow-hidden">
      <div class="px-6 py-4 border-b border-[#E4E4E7] flex items-center justify-between">
        <h2 class="text-[15px] font-semibold text-[#111111]">Teknik Özellikler — {product.name}</h2>
        <span class="font-mono text-[11px] text-[#71717A]">DOĞRULANMIŞ VERİ</span>
      </div>
      <table class="w-full text-left border-collapse text-[13.5px]">
        <tbody class="divide-y divide-[#E4E4E7]">
          {product.specs.map((spec) => (
            <tr class="hover:bg-[#F9FAFB]">
              <th class="py-3.5 px-6 w-1/3 font-mono text-[11.5px] uppercase tracking-[0.03em] text-[#71717A] bg-[#F9FAFB] font-medium">
                {spec.label}
              </th>
              <td class="py-3.5 px-6 font-medium text-[#111111]">{spec.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- YouTube & Social Presence -->
    <SocialPresenceCard
      social={product.social}
      thumbnail={product.slug === 'roborock-s8' ? '/images/thumbnails/roborock-s8-video.jpg' : product.slug === 'samsung-galaxy-z-fold-8' ? '/images/thumbnails/fold8-vs-duo.jpg' : undefined}
      itemTitle={product.name}
    />

    <!-- FAQ -->
    {product.faqs.length > 0 && (
      <section class="tactile-card p-6 sm:p-7 space-y-4">
        <div class="flex items-center gap-2">
          <span class="badge-pill badge-neutral font-mono">SSS</span>
          <h2 class="text-[18px] font-semibold tracking-[-0.02em] text-[#111111]">{product.name} Hakkında Net Cevaplar</h2>
        </div>
        <div class="divide-y divide-[#E4E4E7]">
          {product.faqs.map((faq) => (
            <div class="py-4 first:pt-1 last:pb-0">
              <h3 class="text-[15px] font-semibold text-[#111111]">{faq.question}</h3>
              <p class="text-[13.5px] text-[#52525B] mt-1.5 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
