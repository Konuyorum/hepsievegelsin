---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import PriceTable from '../../components/PriceTable.astro';
import SocialPresenceCard from '../../components/SocialPresenceCard.astro';
import { getAllProducts } from '../../lib/content';
import { SITE, formatTRY } from '../../data/site';

export function getStaticPaths() {
  const products = getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const canonicalPath = `/urun/${product.slug}`;
const fullUrl = new URL(canonicalPath, SITE.url).toString();

// Rich Product + Review + Multi-Store Offers + FAQPage JSON-LD for Google SEO & AI Search Engines (GEO)
const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  brand: { '@type': 'Brand', name: product.brand },
  category: product.category,
  image: new URL(product.image, SITE.url).toString(),
  description: product.tldr,
  url: fullUrl,
  review: {
    '@type': 'Review',
    name: `${product.name} — HEG Tarafsız İnceleme ve Derecelendirme`,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    datePublished: product.datePublished,
    dateModified: product.dateModified,
    reviewBody: product.tldr,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: product.hegScore,
      bestRating: 10,
      worstRating: 0,
    },
    positiveNotes: {
      '@type': 'ItemList',
      itemListElement: product.pros.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p })),
    },
    negativeNotes: {
      '@type': 'ItemList',
      itemListElement: product.cons.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c })),
    },
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'TRY',
    lowPrice: Math.min(...product.offers.map((o) => o.price)),
    highPrice: Math.max(...product.offers.map((o) => o.price)),
    offerCount: product.offers.length,
    offers: product.offers.map((o) => ({
      '@type': 'Offer',
      seller: { '@type': 'Organization', name: o.store },
      price: o.price,
      priceCurrency: 'TRY',
      availability: o.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: new URL(`/git/${o.redirectSlug}`, SITE.url).toString(),
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Ürün Derecelendirme', item: `${SITE.url}/urunler` },
    { '@type': 'ListItem', position: 3, name: product.name, item: fullUrl },
  ],
};
---

<BaseLayout
  title={`${product.name} İnceleme, HEG Puanı (${product.hegScore}/10) ve Canlı Fiyatlar`}
  description={product.tldr}
  image={product.image}
  canonicalPath={canonicalPath}
  ogType="article"
  activeNav="urunler"
  jsonLd={[productSchema, faqSchema, breadcrumbSchema]}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <!-- Breadcrumb + Transparency Metadata -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-slate-500">
        <a href="/" class="hover:text-[#03519F]">Ana Sayfa</a>
        <span>/</span>
        <a href="/urunler" class="hover:text-[#03519F]">Ürün Derecelendirme</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">{product.name}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2">
        <span class="bg-[#111827] text-[#FAD002] px-2.5 py-1 rounded-md font-bold">
          📅 {product.displayDate} GÜNCEL
        </span>
        <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-md font-semibold">
          🛡️ SPONSORLUK YOK • TARAFSIZ ANALİZ
        </span>
      </div>
    </div>

    <!-- Main Product Hero Panel -->
    <header class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- White Product Stage -->
      <div class="lg:col-span-5 bg-white rounded-3xl border border-slate-900/10 p-6 sm:p-8 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">{product.brand} • {product.category}</span>
          {product.social?.youtubeUrl ? (
            <span class="text-[10px] font-mono font-extrabold bg-red-600 text-white px-2.5 py-1 rounded-md">▶ YOUTUBE + WEB</span>
          ) : (
            <span class="text-[10px] font-mono font-extrabold bg-[#03519F] text-white px-2.5 py-1 rounded-md">✦ WEB-ÖZEL ANALİZ</span>
          )}
        </div>

        <div class="aspect-[4/3] w-full flex items-center justify-center my-2">
          <img src={product.image} alt={product.name} class="max-h-72 w-full object-contain" />
        </div>

        {product.reviewStats && (
          <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-500">{product.reviewStats.source}</span>
            <span class="font-mono font-extrabold text-slate-900">
              ★ {product.reviewStats.rating}/5 ({product.reviewStats.count.toLocaleString('tr-TR')} Yorum)
            </span>
          </div>
        )}
      </div>

      <!-- Dark Telemetry & Answer-First TL;DR Panel -->
      <div class="lg:col-span-7 heg-dark-card rounded-3xl p-6 sm:p-8 text-white flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <VerdictBadge verdict={product.verdict} score={product.hegScore} size="lg" />

          <div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
              {product.name}
            </h1>
            <p class="text-sm text-slate-400 mt-1.5">{product.subtitle}</p>
          </div>

          <!-- Answer-First TL;DR Summary Box (Built for Humans & AI Citations) -->
          <div class="bg-white/[0.06] border-l-4 border-[#FAD002] rounded-r-xl p-4 sm:p-5">
            <div class="text-[10px] font-mono font-extrabold uppercase tracking-widest text-[#FAD002] mb-1.5">
              HEG ÖZET KARARI (TL;DR)
            </div>
            <p class="text-sm text-slate-100 leading-relaxed">{product.tldr}</p>
          </div>

          {product.isFakeDealAlert && product.fakeDealReason && (
            <div class="bg-red-500/15 border border-red-500/40 rounded-xl p-4 text-xs sm:text-sm text-red-200 leading-relaxed">
              <strong class="text-red-400 font-mono uppercase block mb-1">⚠ SAHTE İNDİRİM / FİYAT UYARISI:</strong>
              {product.fakeDealReason}
            </div>
          )}
        </div>

        <!-- Bottom Price Highlight -->
        <div class="pt-5 border-t border-white/10 flex flex-wrap items-end justify-between gap-4">
          <div class="tabular-nums">
            <div class="text-[11px] font-mono text-slate-400 uppercase">
              {product.isFakeDealAlert ? 'GÜNCEL PİYASA SATIŞ FİYATI' : 'CANLI EN DİP FİYAT'}
            </div>
            <div class="flex items-baseline gap-3 mt-1">
              <span class="font-mono font-extrabold text-3xl sm:text-4xl text-[#FAD002]">
                {formatTRY(product.currentLowestPrice)}
              </span>
              {product.listPrice > product.currentLowestPrice && (
                <span class="font-mono text-base text-red-400 line-through">
                  {formatTRY(product.listPrice)}
                </span>
              )}
            </div>
            <p class="text-[11px] text-slate-400 mt-1">{product.priceNote}</p>
          </div>

          {product.netSavings > 0 && !product.isFakeDealAlert && (
            <div class="bg-emerald-500/15 border border-emerald-500/40 rounded-xl px-4 py-2.5 text-right font-mono">
              <div class="text-[10px] text-emerald-300 uppercase">SOMUT KAZANÇ</div>
              <div class="text-lg font-extrabold text-emerald-400 tabular-nums">
                {formatTRY(product.netSavings)} (-%{product.discountPercent})
              </div>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Multi-Store Live Price Table (Semantic HTML Table) -->
    <PriceTable
      productName={product.name}
      displayDate={product.displayDate}
      offers={product.offers}
      hasAffiliateLinks={product.hasAffiliateLinks}
    />

    <!-- 5-Criteria HEG ScoreCard -->
    <ScoreCard
      score={product.hegScore}
      verdict={product.verdict}
      criteria={product.criteria}
      verdictHeadline={product.verdictHeadline}
    />

    <!-- Pros & Cons + Who Should Buy / Skip -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-2xl border border-emerald-500/30 p-6 shadow-sm space-y-4">
        <h2 class="text-base font-extrabold text-emerald-800 flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-emerald-100 text-emerald-700 inline-flex items-center justify-center font-mono text-xs">✓</span>
          Güçlü Yönleri (Artılar)
        </h2>
        <ul class="space-y-2.5 text-sm text-slate-700">
          {product.pros.map((pro) => (
            <li class="flex items-start gap-2.5 leading-relaxed">
              <span class="text-emerald-600 font-extrabold mt-0.5">✓</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
        <div class="pt-4 border-t border-slate-100 text-xs text-slate-600 bg-emerald-50/70 rounded-xl p-3.5">
          <strong class="text-emerald-900 block mb-1">Kimler Almalı?</strong>
          {product.whoShouldBuy}
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-red-500/30 p-6 shadow-sm space-y-4">
        <h2 class="text-base font-extrabold text-red-800 flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-red-100 text-red-700 inline-flex items-center justify-center font-mono text-xs">✕</span>
          Kritik Eksiler & Gerçek Şikayetler
        </h2>
        <ul class="space-y-2.5 text-sm text-slate-700">
          {product.cons.map((con) => (
            <li class="flex items-start gap-2.5 leading-relaxed">
              <span class="text-red-500 font-extrabold mt-0.5">✕</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
        <div class="pt-4 border-t border-slate-100 text-xs text-slate-600 bg-red-50/70 rounded-xl p-3.5">
          <strong class="text-red-900 block mb-1">Kimler Uzak Durmalı?</strong>
          {product.whoShouldSkip}
        </div>
      </div>
    </section>

    <!-- Technical Specs Semantic Table -->
    <section class="bg-white rounded-2xl border border-slate-900/10 overflow-hidden shadow-sm">
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200">
        <h2 class="text-base font-extrabold text-slate-900">Teknik Özellikler Tablosu — {product.name}</h2>
      </div>
      <table class="w-full text-left border-collapse text-sm">
        <tbody class="divide-y divide-slate-100">
          {product.specs.map((spec) => (
            <tr class="hover:bg-slate-50">
              <th class="py-3.5 px-6 w-1/3 font-mono text-xs uppercase tracking-wider text-slate-500 bg-slate-50/60">
                {spec.label}
              </th>
              <td class="py-3.5 px-6 font-medium text-slate-900">{spec.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- YouTube & Instagram Cross-Links (Works cleanly with OR without video!) -->
    <SocialPresenceCard
      social={product.social}
      thumbnail={product.slug === 'roborock-s8' ? '/images/thumbnails/roborock-s8-video.jpg' : product.slug === 'samsung-galaxy-z-fold-8' ? '/images/thumbnails/fold8-vs-duo.jpg' : undefined}
      itemTitle={product.name}
    />

    <!-- FAQ Section (Directly feeds AI Search & Google Rich Snippets) -->
    {product.faqs.length > 0 && (
      <section class="bg-white rounded-2xl border border-slate-900/10 p-6 sm:p-8 shadow-sm space-y-5">
        <div>
          <div class="text-[11px] font-mono font-extrabold uppercase tracking-widest text-[#03519F]">
            SIKÇA SORULAN SORULAR
          </div>
          <h2 class="text-xl font-extrabold text-slate-950 mt-0.5">{product.name} Hakkında Net Cevaplar</h2>
        </div>
        <div class="space-y-4 divide-y divide-slate-100">
          {product.faqs.map((faq) => (
            <div class="pt-4 first:pt-0">
              <h3 class="text-base font-bold text-slate-900">{faq.question}</h3>
              <p class="text-sm text-slate-600 mt-1.5 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
