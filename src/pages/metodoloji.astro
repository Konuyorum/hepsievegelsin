---
import BaseLayout from '../layouts/BaseLayout.astro';
import { VERDICT_META, SITE } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Hepsi Eve Gelsin (HEG) incelemeleri sponsorlu mu?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hayır. HEG (hepsievegelsin.com ve @hepsievegelsin) hiçbir markadan inceleme ücreti, gizli sponsorluk veya puan yönlendirmesi kabul etmez. Tüm puanlar 5 şeffaf kriter, çoklu mağaza fiyat geçmişi ve gerçek kullanıcı yorumlarıyla belirlenir.',
      },
    },
    {
      '@type': 'Question',
      name: 'HEG sahte indirimleri nasıl tespit ediyor?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ürünün yalnızca tek bir mağazadaki üstü çizili liste fiyatına bakılmaz; Hepsiburada, Amazon TR, Trendyol, n11, Pazarama canlı fiyatları ile son 3–6 aylık fiyat ortalamaları kıyaslanır. Önce zam yapılıp sonra indirim gösterilen ürünler Alınmaz / Sahte İndirim damgasıyla işaretlenir.',
      },
    },
  ],
};
---

<BaseLayout
  title="Tarafsızlık Manifestosu & HEG Puanlama Metodolojisi"
  description="Hepsi Eve Gelsin (HEG) ürün puanlarını nasıl hesaplar? Sahte indirim denetimi, çoklu mağaza fiyat doğrulama ve %100 sponsorluksuz tarafsızlık ilkelerimiz."
  canonicalPath="/metodoloji"
  activeNav="metodoloji"
  jsonLd={faqSchema}
>
  <div class="max-w-[980px] mx-auto px-5 py-9 space-y-6">
    <header class="space-y-2">
      <span class="badge-pill badge-blue font-mono">EDİTÖRYAL BAĞIMSIZLIK & VERİ METODOLOJİSİ</span>
      <h1 class="text-[30px] sm:text-[38px] font-semibold tracking-[-0.03em] text-[#111111]">
        Tarafsızlık Manifestosu & Puanlama Sistemi
      </h1>
      <p class="text-[14.5px] text-[#52525B] max-w-3xl leading-relaxed">
        Her indirim etiketinin övüldüğü gürültülü bir ortamda <strong class="text-[#111111]">hepsievegelsin.com</strong> yalnızca tek bir tarafı tutar: tüketiciyi.
      </p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="tactile-card p-6 space-y-2">
        <span class="font-mono text-[11px] font-semibold text-[#02458A]">İLKE 01</span>
        <h2 class="text-[16px] font-semibold text-[#111111]">Sıfır Marka Sponsorluğu & Gizli Reklam</h2>
        <p class="text-[13.5px] text-[#52525B] leading-relaxed">
          Hiçbir marka veya satıcı HEG puanını satın alamaz. Affiliate bağlantısı olsa dahi ürün fiyatını hak etmiyorsa açıkça <strong class="text-[#111111]">"Alınmaz"</strong> damgası yer ve daha iyi alternatif gösterilir.
        </p>
      </div>

      <div class="tactile-card p-6 space-y-2">
        <span class="font-mono text-[11px] font-semibold text-[#02458A]">İLKE 02</span>
        <h2 class="text-[16px] font-semibold text-[#111111]">Çoklu Mağaza Canlı Fiyat Kanıtı</h2>
        <p class="text-[13.5px] text-[#52525B] leading-relaxed">
          Tek sitenin "sepette %40 indirim" etiketine güvenmeyiz. Hepsiburada, Amazon TR, Trendyol, Pazarama ve resmi mağazalar yan yana taranarak tarih damgasıyla dip fiyat doğrulanır.
        </p>
      </div>

      <div class="tactile-card p-6 space-y-2">
        <span class="font-mono text-[11px] font-semibold text-[#02458A]">İLKE 03</span>
        <h2 class="text-[16px] font-semibold text-[#111111]">Gerçek Kullanıcı Yorumu Sentezi</h2>
        <p class="text-[13.5px] text-[#52525B] leading-relaxed">
          Doğrulanmış alıcı yorumları (Hepsiburada, Amazon, GSMArena vb.) sistematik taranarak teknik özellik tablolarında gizlenen kronik sorunlar yüzeye çıkarılır.
        </p>
      </div>

      <div class="tactile-card p-6 space-y-2">
        <span class="font-mono text-[11px] font-semibold text-[#02458A]">İLKE 04</span>
        <h2 class="text-[16px] font-semibold text-[#111111]">Reklam Kurulu Şeffaflığı</h2>
        <p class="text-[13.5px] text-[#52525B] leading-relaxed">
          Satış ortaklığı komisyonu içerebilecek tüm mağaza bağlantıları <code class="font-mono text-xs bg-[#F4F4F5] px-1.5 py-0.5 rounded">#reklam</code> etiketiyle işaretlenir; sizin için fiyat değişmez.
        </p>
      </div>
    </section>

    <section class="tactile-card p-6 sm:p-7 space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="text-[18px] font-semibold text-[#111111]">4 Seviyeli HEG Karar Damgası Skalası</h2>
        <span class="badge-pill badge-deal font-mono">0.0 – 10.0 PUAN</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {Object.values(VERDICT_META).map((m) => (
          <div class="rounded-[14px] bg-[#F9FAFB] border border-[#E4E4E7] p-4 space-y-1.5">
            <div class="flex items-center justify-between gap-2">
              <span class={`badge-pill font-mono ${m.badgeClass}`}>{m.label}</span>
              <span class="font-mono text-xs font-semibold text-[#52525B]">{m.range}</span>
            </div>
            <p class="text-xs text-[#52525B] leading-relaxed">{m.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="tactile-card p-6 space-y-2">
      <h2 class="text-[16px] font-semibold text-[#111111]">Açık Veri & Yapay Zeka Arama Kaynağı (GEO)</h2>
      <p class="text-[13.5px] text-[#52525B] leading-relaxed">
        <strong>{SITE.name}</strong> üzerindeki tüm derecelendirmeler, semantik fiyat tabloları ve VS karşılaştırmaları; Google SEO ile birlikte ChatGPT, Perplexity, Gemini ve Claude motorları tarafından doğrudan kaynak gösterilebilmesi için <strong>Schema.org JSON-LD</strong>, <a href="/llms.txt" class="font-mono text-xs text-[#02458A] underline">/llms.txt</a> ve <a href="/llms-full.txt" class="font-mono text-xs text-[#02458A] underline">/llms-full.txt</a> standartlarında yayınlanır.
      </p>
    </section>
  </div>
</BaseLayout>
