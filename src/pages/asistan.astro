---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProducts, getAllComparisons } from '../lib/content';
import { SITE, formatTRY } from '../data/site';

const verifiedProducts = getAllProducts().map((p) => ({
  type: 'urun',
  slug: p.slug,
  title: p.name,
  subtitle: p.subtitle,
  hegScore: `${p.hegScore.toFixed(1)}/10`,
  price: formatTRY(p.currentLowestPrice),
  href: `/urun/${p.slug}`,
  keywords: `${p.name} ${p.brand} ${p.category} ${p.subtitle}`.toLowerCase(),
}));

const verifiedComparisons = getAllComparisons().map((c) => ({
  type: 'vs',
  slug: c.slug,
  title: c.title,
  subtitle: `${c.hookBadge} · Skor ${c.scoreA}–${c.scoreB}`,
  hegScore: `${c.scoreA}–${c.scoreB}`,
  price: c.priceDiffText,
  href: `/vs/${c.slug}`,
  keywords: `${c.title} ${c.productA.name} ${c.productB.name} ${c.category}`.toLowerCase(),
}));

const verifiedCatalog = [...verifiedComparisons, ...verifiedProducts];
const amazonTag = SITE.amazonTag;
---

<BaseLayout
  title="HEG AI Ürün Analizi (Pozitifler/Negatifler + Daha İyi Alternatif) & Google Araştırma"
  description="Sadece marka ve ürün adı girerek gerçek kullanıcı yorumlarından derlenen Pozitifler & Negatifler tablosu, daha iyi alternatif önerisi ve ayrı Google Web Araştırması."
  canonicalPath="/asistan"
  activeNav="asistan"
>
  <div class="max-w-[980px] mx-auto px-5 py-9 space-y-6">
    <!-- Header -->
    <div class="text-center space-y-2.5">
      <span class="badge-pill badge-blue font-mono">HEG AI ÜRÜN ANALİZİ · SADECE MARKA & MODEL</span>
      <h1 class="text-[30px] sm:text-[40px] font-semibold tracking-[-0.03em] text-[#111111] leading-tight">
        Marka veya Ürün Adını Girin
      </h1>
      <p class="text-[14px] text-[#52525B] max-w-2xl mx-auto">
        Kullanıcı yorumlarından derlenen <strong class="text-[#111111]">Pozitifler & Negatifler tablosunu</strong> ve fiyat/özellik/yorum açısından <strong class="text-[#111111]">daha iyi bir alternatifi varsa</strong> anında görün.
      </p>
    </div>

    <!-- Tactile Product/Brand-Only AI Search Box -->
    <div class="tactile-card p-3 space-y-2">
      <form id="aiSearchForm" class="space-y-2.5">
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            id="aiQ1"
            type="text"
            maxlength="60"
            placeholder="Sadece marka ve model girin (Örn: Dyson V15 Detect, Roborock S8)..."
            class="flex-1 bg-[#F9FAFB] border border-[#E4E4E7] rounded-full text-[#111111] placeholder-[#71717A] px-5 py-3 text-sm focus:border-[#0251A0] focus:bg-white focus:outline-none transition"
          />
          <button
            id="aiVsToggle"
            type="button"
            class="btn-pill btn-pill-outline !py-3 !px-4 !text-xs font-mono"
          >
            ⚖ VS Modu
          </button>
          <button
            type="submit"
            class="btn-pill btn-pill-primary !py-3 !px-6"
          >
            AI Analiz <span class="arrow">↗</span>
          </button>
        </div>

        <div id="aiVsWrap" class="hidden">
          <input
            id="aiQ2"
            type="text"
            maxlength="60"
            placeholder="Karşılaştırılacak 2. marka/model (Örn: Dreame L10s Ultra)..."
            class="w-full bg-[#F9FAFB] border border-[#BDD6F2] rounded-full text-[#111111] placeholder-[#71717A] px-5 py-3 text-sm focus:border-[#0251A0] focus:bg-white focus:outline-none transition"
          />
        </div>
      </form>
      <div class="px-3 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-[#71717A]">
        <span>* Bu alan yalnızca marka/ürün analizi içindir; soru cümleleri kabul edilmez.</span>
        <a href="#google-arastirma" class="text-[#02458A] font-semibold hover:underline">Soru sormak için Google Araştırması ↓</a>
      </div>
    </div>

    <!-- Brand/Product Preset Pills -->
    <div class="flex flex-wrap justify-center gap-2">
      {['Dyson V15 Detect', 'Roborock S8', 'Samsung Galaxy Z Fold 8', 'Anker Soundcore Liberty 4 NC', 'Philips Airfryer XXL'].map((preset) => (
        <button
          type="button"
          data-preset={preset}
          class="preset-btn btn-pill btn-pill-outline !py-1.5 !px-3.5 !text-xs"
        >
          {preset}
        </button>
      ))}
    </div>

    <!-- Verified Match Box -->
    <div id="verifiedMatchBox" class="hidden tactile-card !border-[#BDD6F2] p-6 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="badge-pill badge-blue font-mono">✓ DOĞRULANMIŞ HEG EDİTÖRYAL ANALİZİ BULUNDU</span>
        <span class="font-mono text-[11px] text-[#71717A]">Canlı fiyat & 5 kriterli karne mevcut</span>
      </div>
      <div id="verifiedMatchList" class="grid grid-cols-1 md:grid-cols-2 gap-3.5"></div>
    </div>

    <!-- Loading -->
    <div id="aiLoading" class="hidden tactile-card p-10 text-center space-y-3">
      <div class="w-9 h-9 rounded-full border-[3px] border-[#E4E4E7] border-t-[#111111] animate-spin mx-auto"></div>
      <div class="font-semibold text-[15px] text-[#111111]">Kullanıcı Yorumları & Alternatifler Derleniyor...</div>
      <p class="text-xs font-mono text-[#71717A]">Pozitifler/Negatifler tablosu ve daha iyi rakip karşılaştırması hazırlanıyor.</p>
    </div>

    <div id="aiNotice" class="hidden tactile-card !border-[#FECACA] bg-[#FEF2F2]/40 p-5 space-y-2.5"></div>
    <div id="aiOutput" class="hidden space-y-5"></div>

    <!-- SEPARATE MODULE: FREE GOOGLE WEB RESEARCH (For General Questions) -->
    <section id="google-arastirma" class="pt-4">
      <div class="tactile-card p-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <span class="badge-pill badge-neutral font-mono">GENEL SORULAR & WEB ARAŞTIRMASI</span>
            <h2 class="text-[18px] font-semibold tracking-[-0.02em] text-[#111111] mt-1.5">
              Google ile Web Araştırması Yap
            </h2>
            <p class="text-xs text-[#52525B] mt-0.5">
              Ürün adı dışındaki tüm sorularınız, forum araştırmaları veya genel bilgi aramaları için AI analizinden ayrı ücretsiz Google araması.
            </p>
          </div>
        </div>

        <form id="googleSearchForm" class="flex flex-col sm:flex-row gap-2">
          <input
            id="googleQ"
            type="text"
            placeholder="Herhangi bir soru veya konu yazın (Örn: Robot süpürge alırken nelere dikkat edilir?)..."
            class="flex-1 bg-[#F9FAFB] border border-[#E4E4E7] rounded-full text-[#111111] placeholder-[#71717A] px-5 py-2.5 text-sm focus:border-[#0251A0] focus:bg-white focus:outline-none transition"
          />
          <button type="submit" class="btn-pill btn-pill-outline !py-2.5 !px-5 !text-xs font-semibold">
            Google'da Ara ↗
          </button>
        </form>
      </div>
    </section>
  </div>

  <script define:vars={{ verifiedCatalog, amazonTag }}>
    const q1 = document.getElementById('aiQ1');
    const q2 = document.getElementById('aiQ2');
    const vsToggle = document.getElementById('aiVsToggle');
    const vsWrap = document.getElementById('aiVsWrap');
    const form = document.getElementById('aiSearchForm');
    const loading = document.getElementById('aiLoading');
    const notice = document.getElementById('aiNotice');
    const output = document.getElementById('aiOutput');
    const verifiedBox = document.getElementById('verifiedMatchBox');
    const verifiedList = document.getElementById('verifiedMatchList');

    let isVS = false;

    const QUESTION_RE =
      /[?¿]|(^|\s)(nasıl|neden|niçin|niye|nedir|kimdir|ne\s+zaman|nerede|nereye|hangisi|hangi|kaç\s+tane|kaç\s+lira|ne\s+kadar|tavsiye\s+eder|önerir\s+misin|alınır\s+mı|değer\s+mi|yazar\s+mısın|anlat|açıkla|hesapla|çevir|özetle|kod\s+yaz|merhaba|selam|naber|how|what|why|when|where|who|which)(\s|$)/i;

    function isQuestionOrTooLong(val) {
      if (!val) return true;
      if (QUESTION_RE.test(val)) return true;
      return val.trim().split(/\s+/).filter(Boolean).length > 6;
    }

    function safeText(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function safeListHtml(html) {
      return String(html || '')
        .replace(/<script[\s\S]*?<\/script>/gi, '')
        .replace(/\son\w+="[^"]*"/gi, '')
        .replace(/\son\w+='[^']*'/gi, '')
        .replace(/javascript:/gi, '');
    }

    function setVS(state) {
      isVS = state;
      vsWrap?.classList.toggle('hidden', !isVS);
      if (vsToggle) {
        vsToggle.textContent = isVS ? '✕ VS Kapat' : '⚖ VS Modu';
        vsToggle.classList.toggle('!bg-[#EBF3FC]', isVS);
        vsToggle.classList.toggle('!text-[#02458A]', isVS);
        vsToggle.classList.toggle('!border-[#BDD6F2]', isVS);
      }
    }

    vsToggle?.addEventListener('click', () => {
      setVS(!isVS);
      if (isVS) q2?.focus();
    });

    function buildStoreLinks(keyword) {
      const enc = encodeURIComponent(keyword);
      return `
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-3">
          <a href="https://www.amazon.com.tr/s?k=${enc}&tag=${amazonTag}" target="_blank" rel="nofollow sponsored noopener noreferrer" class="btn-pill btn-pill-primary !py-2 !text-xs">Amazon TR (#reklam) ↗</a>
          <a href="https://www.hepsiburada.com/ara?q=${enc}" target="_blank" rel="noopener noreferrer" class="btn-pill btn-pill-outline !py-2 !text-xs">Hepsiburada ↗</a>
          <a href="https://www.trendyol.com/sr?q=${enc}" target="_blank" rel="noopener noreferrer" class="btn-pill btn-pill-outline !py-2 !text-xs">Trendyol ↗</a>
          <a href="https://www.akakce.com/arama/?q=${enc}" target="_blank" rel="noopener noreferrer" class="btn-pill btn-pill-outline !py-2 !text-xs">Akakçe Fiyat ↗</a>
        </div>`;
    }

    function checkVerifiedMatches(queryText) {
      const norm = queryText.toLowerCase();
      const words = norm.split(/\s+/).filter((w) => w.length > 1);
      const hits = verifiedCatalog.filter((item) => {
        if (item.keywords.includes(norm)) return true;
        return words.length > 0 && words.every((w) => item.keywords.includes(w));
      });

      if (hits.length > 0 && verifiedBox && verifiedList) {
        verifiedList.innerHTML = hits
          .map(
            (h) => `
          <a href="${h.href}" class="block rounded-[14px] border border-[#E4E4E7] hover:border-[#0251A0] p-4 transition bg-[#F9FAFB] hover:bg-[#EBF3FC]/40">
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="font-mono text-[10px] font-semibold uppercase text-[#02458A]">${h.type === 'vs' ? 'HEG VS KARŞILAŞTIRMA' : 'HEG ÜRÜN KARNESİ'}</span>
              <span class="badge-pill badge-deal font-mono">${h.hegScore}</span>
            </div>
            <div class="font-semibold text-[#111111]">${h.title}</div>
            <div class="text-xs text-[#52525B] mt-1">${h.subtitle} · <strong>${h.price}</strong></div>
            <div class="text-xs font-semibold text-[#02458A] mt-2">Doğrulanmış Analizi Aç ↗</div>
          </a>`
          )
          .join('');
        verifiedBox.classList.remove('hidden');
        return true;
      }
      verifiedBox?.classList.add('hidden');
      return false;
    }

    function showNotice(msg, suggestedGoogleQuery = '') {
      if (!notice) return;
      notice.innerHTML = `
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="text-sm font-medium text-[#991B1B]">${safeText(msg)}</div>
          ${
            suggestedGoogleQuery
              ? `<a href="https://www.google.com/search?q=${encodeURIComponent(suggestedGoogleQuery)}" target="_blank" rel="noopener noreferrer" class="btn-pill btn-pill-outline !py-1.5 !px-3.5 !text-xs shrink-0">Bunu Google'da Ara ↗</a>`
              : ''
          }
        </div>`;
      notice.classList.remove('hidden');
    }

    async function runSearch(query1, query2 = '', vsMode = false) {
      if (!query1) return;
      notice?.classList.add('hidden');
      output?.classList.add('hidden');

      // Client-side brand/product-only guard
      if (isQuestionOrTooLong(query1) || (vsMode && query2 && isQuestionOrTooLong(query2))) {
        verifiedBox?.classList.add('hidden');
        showNotice(
          'AI Analiz alanına soru sorulamaz; yalnızca marka veya ürün adı girilebilir (Örn: Dyson V15 Detect, Roborock S8).',
          query1
        );
        const gInput = document.getElementById('googleQ');
        if (gInput) gInput.value = query1;
        return;
      }

      const combined = vsMode && query2 ? `${query1} ${query2}` : query1;
      checkVerifiedMatches(combined);
      loading?.classList.remove('hidden');

      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'X-HEG-Client': 'web-v2',
          },
          body: JSON.stringify({ query: query1, query2, isVS: vsMode }),
        });

        const data = await res.json().catch(() => null);
        loading?.classList.add('hidden');

        if (!res.ok || !data) {
          showNotice(data?.message || 'Yapay zeka servisi şu an yanıt veremedi. Lütfen tekrar deneyin.');
          return;
        }

        if (data.type === 'error') {
          showNotice(data.message, query1);
          return;
        }

        if (output) {
          if (data.type === 'comparison') {
            output.innerHTML = `
              <div class="tactile-card p-6 space-y-5">
                <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-[#E4E4E7]">
                  <h2 class="text-[22px] font-semibold text-[#111111]">${safeText(data.p1_name)} <span class="text-[#71717A] font-normal">vs</span> ${safeText(data.p2_name)}</h2>
                  <span class="badge-pill badge-deal font-mono">HEG AI CANLI VS</span>
                </div>
                <div class="bg-[#F9FAFB] border-l-[3px] border-[#0251A0] rounded-r-xl p-4 text-[13.5px] text-[#111111] leading-relaxed">${safeText(data.summary)}</div>
                <div class="overflow-x-auto border border-[#E4E4E7] rounded-[14px]">
                  <table class="w-full text-left border-collapse text-[13px]">
                    <thead>
                      <tr class="bg-[#F9FAFB] border-b border-[#E4E4E7] text-[11px] font-mono uppercase text-[#71717A]">
                        <th class="py-3 px-4">Kriter</th>
                        <th class="py-3 px-4 text-[#02458A]">${safeText(data.p1_name)}</th>
                        <th class="py-3 px-4 text-[#111111]">${safeText(data.p2_name)}</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E4E4E7]">
                      ${(data.table || [])
                        .map(
                          (row) => `
                        <tr>
                          <td class="py-3 px-4 font-semibold text-[#111111]">${safeText(row.feature)}</td>
                          <td class="py-3 px-4 ${row.winner === 1 ? 'bg-[#FFFDF0] font-semibold text-[#111111]' : 'text-[#52525B]'}">${safeText(row.val1)} ${row.winner === 1 ? '✓' : ''}</td>
                          <td class="py-3 px-4 ${row.winner === 2 ? 'bg-[#FFFDF0] font-semibold text-[#111111]' : 'text-[#52525B]'}">${safeText(row.val2)} ${row.winner === 2 ? '✓' : ''}</td>
                        </tr>`
                        )
                        .join('')}
                    </tbody>
                  </table>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="bg-[#F9FAFB] p-4 rounded-[14px] border border-[#E4E4E7]">
                    <div class="font-mono text-xs font-semibold text-[#02458A] mb-1">${safeText(data.p1_name)} Fiyatları</div>
                    ${buildStoreLinks(data.p1_name)}
                  </div>
                  <div class="bg-[#F9FAFB] p-4 rounded-[14px] border border-[#E4E4E7]">
                    <div class="font-mono text-xs font-semibold text-[#111111] mb-1">${safeText(data.p2_name)} Fiyatları</div>
                    ${buildStoreLinks(data.p2_name)}
                  </div>
                </div>
              </div>`;
          } else {
            // Single Product: Structured Pozitifler & Negatifler Table + Better Alternative Card!
            const reviewRows = Array.isArray(data.review_table) ? data.review_table : [];
            const alt = data.alternative && data.alternative.has_better && data.alternative.name ? data.alternative : null;

            const reviewTableHtml =
              reviewRows.length > 0
                ? `
                <div class="overflow-x-auto border border-[#E4E4E7] rounded-[14px]">
                  <table class="w-full text-left border-collapse text-[13.5px]">
                    <thead>
                      <tr class="bg-[#F9FAFB] border-b border-[#E4E4E7] text-[11px] font-mono uppercase tracking-[0.04em]">
                        <th class="py-3 px-4 text-[#71717A] w-1/5">Kriter / Konu</th>
                        <th class="py-3 px-4 text-[#111111] w-2/5">✓ Pozitifler (Olumlu Yorumlar)</th>
                        <th class="py-3 px-4 text-[#B91C1C] w-2/5">✕ Negatifler (Olumsuz Yorumlar)</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E4E4E7] align-top">
                      ${reviewRows
                        .map(
                          (row) => `
                        <tr class="hover:bg-[#F9FAFB] transition">
                          <td class="py-3.5 px-4 font-semibold text-[#111111] bg-[#F9FAFB]/60">${safeText(row.topic)}</td>
                          <td class="py-3.5 px-4 text-[#111111] leading-relaxed">
                            <span class="font-mono font-bold text-[#02458A] mr-1">+</span>${safeText(row.positive)}
                          </td>
                          <td class="py-3.5 px-4 text-[#52525B] bg-[#FEF2F2]/35 leading-relaxed">
                            <span class="font-mono font-bold text-[#EF4444] mr-1">−</span>${safeText(row.negative)}
                          </td>
                        </tr>`
                        )
                        .join('')}
                    </tbody>
                  </table>
                </div>`
                : `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-[13.5px]">
                  <div class="bg-[#F9FAFB] border border-[#E4E4E7] rounded-[14px] p-4">
                    <h3 class="font-semibold text-[#111111] mb-2">✓ Pozitifler</h3>
                    <div class="text-[#52525B] space-y-1">${safeListHtml(data.pros)}</div>
                  </div>
                  <div class="bg-[#FEF2F2]/60 border border-[#FECACA] rounded-[14px] p-4">
                    <h3 class="font-semibold text-[#991B1B] mb-2">✕ Negatifler</h3>
                    <div class="text-[#52525B] space-y-1">${safeListHtml(data.cons)}</div>
                  </div>
                </div>`;

            const altHtml = alt
              ? `
              <div class="tactile-card !border-[#E5B800] bg-[#FFFDF0] p-6 space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <span class="badge-pill badge-deal font-mono">★ HEG DAHA İYİ ALTERNATİF ÖNERİSİ</span>
                    <h3 class="text-[20px] font-semibold tracking-[-0.02em] text-[#111111] mt-2">${safeText(alt.name)}</h3>
                  </div>
                  <span class="badge-pill badge-blue font-mono">FİYAT · ÖZELLİK · YORUM</span>
                </div>
                <p class="text-[13.5px] text-[#111111] leading-relaxed">${safeText(alt.reason)}</p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
                  <div class="bg-white border border-[#E4E4E7] rounded-[12px] p-3.5">
                    <div class="font-mono text-[10px] font-semibold uppercase text-[#71717A] mb-1">FİYAT AVANTAJI</div>
                    <div class="text-[#111111] leading-relaxed">${safeText(alt.price_advantage)}</div>
                  </div>
                  <div class="bg-white border border-[#E4E4E7] rounded-[12px] p-3.5">
                    <div class="font-mono text-[10px] font-semibold uppercase text-[#02458A] mb-1">ÖZELLİK AVANTAJI</div>
                    <div class="text-[#111111] leading-relaxed">${safeText(alt.feature_advantage)}</div>
                  </div>
                  <div class="bg-white border border-[#E4E4E7] rounded-[12px] p-3.5">
                    <div class="font-mono text-[10px] font-semibold uppercase text-[#9A7400] mb-1">YORUM AVANTAJI</div>
                    <div class="text-[#111111] leading-relaxed">${safeText(alt.review_advantage)}</div>
                  </div>
                </div>
                <div>
                  <div class="font-mono text-[10.5px] text-[#71717A] uppercase mb-1">${safeText(alt.name)} — Canlı Mağaza Fiyatları</div>
                  ${buildStoreLinks(alt.name)}
                </div>
              </div>`
              : '';

            output.innerHTML = `
              <div class="tactile-card p-6 space-y-5">
                <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#E4E4E7]">
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="badge-pill badge-blue font-mono">KULLANICI YORUM ANALİZİ</span>
                      ${data.verdict_label ? `<span class="badge-pill badge-neutral font-mono">${safeText(data.verdict_label)}</span>` : ''}
                    </div>
                    <h2 class="text-[22px] font-semibold text-[#111111] mt-2">${safeText(data.title || query1)}</h2>
                  </div>
                  ${data.heg_score ? `<div class="badge-pill badge-deal font-mono !text-base !px-4 !py-1.5">${safeText(data.heg_score)}/10</div>` : ''}
                </div>

                <div class="bg-[#F9FAFB] border-l-[3px] border-[#0251A0] rounded-r-xl p-4 text-[13.5px] text-[#111111] leading-relaxed">
                  ${safeText(data.verdict)}
                </div>

                ${reviewTableHtml}

                <div>
                  <div class="font-mono text-[11px] text-[#71717A] uppercase mb-1">${safeText(query1)} — Çoklu Mağaza Canlı Fiyat Kontrolü</div>
                  ${buildStoreLinks(data.amazon_keyword || query1)}
                </div>
              </div>
              ${altHtml}`;
          }
          output.classList.remove('hidden');
        }
      } catch (err) {
        loading?.classList.add('hidden');
        showNotice('Bağlantı kurulamadı. Lütfen birkaç saniye sonra tekrar deneyin.');
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      runSearch(q1?.value.trim() || '', q2?.value.trim() || '', isVS);
    });

    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-preset') || '';
        if (q1) q1.value = text;
        setVS(false);
        runSearch(text, '', false);
      });
    });

    // Separate Free Google Web Search Form
    document.getElementById('googleSearchForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const gq = document.getElementById('googleQ')?.value.trim();
      if (!gq) return;
      window.open(`https://www.google.com/search?q=${encodeURIComponent(gq)}`, '_blank', 'noopener,noreferrer');
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get('vs') === '1') {
      setVS(true);
      const p1 = params.get('q1') || '';
      const p2 = params.get('q2') || '';
      if (q1) q1.value = p1;
      if (q2) q2.value = p2;
      if (p1 && p2) runSearch(p1, p2, true);
    } else if (params.get('ara')) {
      const q = params.get('ara') || '';
      if (q1) q1.value = q;
      runSearch(q, '', false);
    }
  </script>
</BaseLayout>
