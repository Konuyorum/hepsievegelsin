---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSearchWidget from '../components/HeroSearchWidget.astro';
import ProductCard from '../components/ProductCard.astro';
import ComparisonCard from '../components/ComparisonCard.astro';
import { getAllProducts, getAllComparisons, getLatestCatalog } from '../lib/content';
import { SITE, formatTRY, CATALOG_STATUS_META } from '../data/site';

const products = getAllProducts();
const comparisons = getAllComparisons();
const latestCatalog = getLatestCatalog();

const heroComparison = comparisons[0];
const fakeDealAlerts = products.filter((p) => p.isFakeDealAlert);
const topDeals = products.filter((p) => !p.isFakeDealAlert);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'tr-TR',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/asistan?ara={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="HEG — Hepsi Eve Gelsin | Tarafsız Ürün Derecelendirme, Canlı Fiyat & HEG VS"
  description={SITE.description}
  canonicalPath="/"
  activeNav="home"
  jsonLd={websiteSchema}
>
  <!-- 1. ARCHITECTURAL HERO SECTION (50/50 Balance: Brand + AI Search | Featured VS) -->
  <section class="heg-hero-surface text-white border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left 7 Cols: Value Prop & Instant Search/VS -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex flex-wrap items-center gap-2 bg-white/[0.07] border border-white/15 rounded-full px-3.5 py-1.5 text-[11px] font-mono">
            <span class="text-[#FAD002] font-extrabold">GERÇEK İNDİRİM</span>
            <span class="text-slate-500">•</span>
            <span class="text-sky-300 font-bold">TARAFSIZ ANALİZ</span>
            <span class="text-slate-500">•</span>
            <span class="text-emerald-400 font-bold">NET KARAR</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold tracking-tight leading-[1.08] text-white">
            Gerçek indirimi sahte indirimden ayıran <span class="text-[#FAD002]">bağımsız</span> karar platformu.
          </h1>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
            Marka sponsorluğu almadan; çoklu mağaza canlı fiyatları, teknik benchmark verileri ve binlerce gerçek kullanıcı yorumuyla ürünleri <strong class="text-white">10 üzerinden derecelendiriyor</strong>, gerektiğinde açıkça <strong class="text-red-400">"Alınmaz"</strong> diyoruz.
          </p>

          <!-- Unified Search & VS Widget -->
          <HeroSearchWidget />

          <!-- Trust Proof Metrics -->
          <div class="grid grid-cols-3 gap-3 pt-2 max-w-xl">
            <div class="bg-white/[0.04] border border-white/10 rounded-xl p-3">
              <div class="font-mono font-extrabold text-lg text-[#FAD002] tabular-nums">4–5 Mağaza</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Canlı Fiyat Tarama</div>
            </div>
            <div class="bg-white/[0.04] border border-white/10 rounded-xl p-3">
              <div class="font-mono font-extrabold text-lg text-emerald-400 tabular-nums">%0 Sponsor</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Tam Bağımsız Puan</div>
            </div>
            <div class="bg-white/[0.04] border border-white/10 rounded-xl p-3">
              <div class="font-mono font-extrabold text-lg text-sky-300 tabular-nums">Web + YT</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Çapraz Veri Merkezi</div>
            </div>
          </div>
        </div>

        <!-- Right 5 Cols: Featured Flagship HEG VS Spotlight -->
        {heroComparison && (
          <div class="lg:col-span-5">
            <div class="bg-[#0B1120]/90 backdrop-blur-xl border border-white/15 rounded-2xl overflow-hidden shadow-2xl">
              <div class="px-5 py-3 bg-white/[0.04] border-b border-white/10 flex items-center justify-between text-[11px] font-mono">
                <span class="text-[#FAD002] font-extrabold">🔥 ÖNE ÇIKAN HEG VS</span>
                <span class="text-slate-400">📅 {heroComparison.displayDate}</span>
              </div>

              <a href={`/vs/${heroComparison.slug}`} class="block relative group overflow-hidden">
                <img
                  src={heroComparison.thumbnail}
                  alt={heroComparison.title}
                  class="w-full aspect-video object-cover group-hover:scale-[1.03] transition duration-500"
                />
              </a>

              <div class="px-5 py-2.5 bg-[#070B14] border-y border-white/10 flex items-center justify-between font-mono text-xs font-extrabold">
                <span class="text-slate-400">FİNAL SKOR</span>
                <div>
                  <span class="text-sky-300">{heroComparison.productA.shortName}</span>
                  <span class="bg-[#03519F] text-white px-2 py-0.5 rounded mx-1 tabular-nums">{heroComparison.scoreA}</span>
                  <span class="text-slate-500">–</span>
                  <span class="bg-[#FAD002] text-[#0B0B0D] px-2 py-0.5 rounded mx-1 tabular-nums">{heroComparison.scoreB}</span>
                  <span class="text-[#FAD002]">{heroComparison.productB.shortName}</span>
                </div>
              </div>

              <div class="p-5 space-y-4">
                <div>
                  <h2 class="text-lg font-extrabold text-white leading-snug">
                    <a href={`/vs/${heroComparison.slug}`} class="hover:text-[#FAD002] transition">
                      {heroComparison.title}
                    </a>
                  </h2>
                  <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
                    {heroComparison.tldr}
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-2.5">
                  <a
                    href={`/vs/${heroComparison.slug}`}
                    class="flex-1 inline-flex items-center justify-center gap-2 bg-[#03519F] hover:bg-[#0B6BCB] text-white text-xs font-bold py-3 px-4 rounded-xl transition"
                  >
                    Raund Analizini Oku →
                  </a>
                  {heroComparison.social?.youtubeUrl && (
                    <a
                      href={heroComparison.social.youtubeUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-1.5 bg-red-600 hover:bg-red-500 text-white text-xs font-bold py-3 px-4 rounded-xl transition"
                    >
                      ▶ İzle
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 2. HEG VS COMPARISONS SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
      <div>
        <div class="text-xs font-mono font-extrabold uppercase tracking-[0.2em] text-[#03519F]">
          01 / BÖLÜNMÜŞ EKRAN KARŞILAŞTIRMA
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-950 mt-1">
          HEG VS — Raund Bazlı Kapışmalar
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          Karar aşamasındaki kullanıcılar için teknik benchmark, gerçek yorum ve canlı fiyat düelloları (YouTube & Web-Özel).
        </p>
      </div>
      <a href="/vs" class="text-sm font-bold text-[#03519F] hover:underline">
        Tüm VS Analizleri →
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {comparisons.map((comp) => <ComparisonCard comparison={comp} />)}
    </div>
  </section>

  <!-- 3. INDEPENDENT PRODUCT RATINGS & VERIFIED DEALS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
      <div>
        <div class="text-xs font-mono font-extrabold uppercase tracking-[0.2em] text-[#03519F]">
          02 / BAĞIMSIZ ÜRÜN DERECELENDİRME & FIRSATLAR
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-950 mt-1">
          HEG Puanlı İncelemeler & Canlı Fırsatlar
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          Yalnızca YouTube videolarımız değil — web platformumuza özel bağımsız 5 kriterli puanlamalar ve çoklu mağaza fiyat denetimleri.
        </p>
      </div>
      <a href="/urunler" class="text-sm font-bold text-[#03519F] hover:underline">
        Tüm Derecelendirmeler ({products.length}) →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {topDeals.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <!-- 4. FAKE DEAL / "ALINMAZ" WARNING BAND (HEG SIGNATURE TRUST ANCHOR) -->
  {fakeDealAlerts.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
      <div class="rounded-3xl bg-[#111827] border-2 border-red-500/40 overflow-hidden shadow-2xl">
        <div class="bg-red-600/20 border-b border-red-500/30 px-6 sm:px-8 py-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-red-600 text-white font-extrabold text-sm">!</span>
            <div>
              <div class="text-[11px] font-mono font-extrabold uppercase tracking-widest text-red-400">
                HEG SAHTE İNDİRİM & ALINMAZ RADARI
              </div>
              <h2 class="text-lg sm:text-xl font-extrabold text-white">
                Her İndirimi Övmüyoruz — Uzak Durmanız Gerekenler
              </h2>
            </div>
          </div>
          <a href="/metodoloji" class="text-xs font-mono font-bold text-red-300 hover:text-white underline">
            Sahte İndirimi Nasıl Yakalıyoruz?
          </a>
        </div>

        <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          {fakeDealAlerts.map((alertItem) => (
            <>
              <div class="lg:col-span-4 bg-white rounded-2xl p-5 flex items-center justify-center">
                <img src={alertItem.image} alt={alertItem.name} class="max-h-48 object-contain" />
              </div>
              <div class="lg:col-span-8 space-y-4 text-white">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="bg-red-600 text-white text-xs font-mono font-extrabold px-3 py-1 rounded-lg">
                    ALINMAZ • {alertItem.hegScore.toFixed(1)}/10
                  </span>
                  <span class="text-xs font-mono text-slate-400">✦ HEG WEB-ÖZEL DENETİM • {alertItem.displayDate}</span>
                </div>
                <h3 class="text-2xl font-extrabold">{alertItem.name}</h3>
                <p class="text-sm text-slate-300 leading-relaxed">
                  {alertItem.fakeDealReason || alertItem.tldr}
                </p>
                <div class="flex flex-wrap items-center gap-4 pt-1">
                  <div class="bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 font-mono">
                    <div class="text-[10px] text-slate-400">SÖZDE LİSTE → SATIŞ</div>
                    <div class="text-sm font-extrabold">
                      <span class="text-red-400 line-through mr-2">{formatTRY(alertItem.listPrice)}</span>
                      <span class="text-white">{formatTRY(alertItem.currentLowestPrice)}</span>
                    </div>
                  </div>
                  <a
                    href={`/urun/${alertItem.slug}`}
                    class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white text-xs font-extrabold px-5 py-3.5 rounded-xl transition"
                  >
                    Neden Alınmaz? Detaylı Kanıtı Gör →
                  </a>
                </div>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. WEEKLY SMART CATALOG PREVIEW (A101 / BİM / ŞOK / MİGROS) -->
  {latestCatalog && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
      <div class="bg-white rounded-3xl border border-slate-900/10 shadow-sm overflow-hidden">
        <div class="px-6 sm:px-8 py-6 bg-[#111827] text-white flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="text-[11px] font-mono font-extrabold uppercase tracking-[0.2em] text-[#FAD002]">
              03 / HAFTALIK AKILLI KATALOG ELEMESİ ({latestCatalog.weekLabel})
            </div>
            <h2 class="text-2xl font-extrabold mt-1">A101 • BİM • ŞOK • Migros Fiyat Denetimi</h2>
            <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-2xl">
              {latestCatalog.summary}
            </p>
          </div>
          <a
            href="/katalog"
            class="bg-[#FAD002] hover:bg-[#ffe03a] text-[#0B0B0D] text-xs font-extrabold px-5 py-3 rounded-xl transition shrink-0"
          >
            Tüm Katalog Elemesini Gör ({latestCatalog.items.length} Ürün) →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-slate-200">
          {latestCatalog.items.slice(0, 4).map((item) => {
            const st = CATALOG_STATUS_META[item.status];
            return (
              <div class="p-5 flex flex-col justify-between gap-3 hover:bg-slate-50 transition">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-xs font-mono font-extrabold bg-slate-900 text-white px-2.5 py-0.5 rounded">
                      {item.market}
                    </span>
                    <span class={`text-[10px] font-mono font-extrabold px-2 py-0.5 rounded border ${st.bgClass} ${st.textClass} ${st.borderClass}`}>
                      {st.label}
                    </span>
                  </div>
                  <h3 class="text-sm font-extrabold text-slate-900 leading-snug">{item.name}</h3>
                  <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">{item.verdictNote}</p>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-mono tabular-nums">
                  <div>
                    <div class="text-[10px] text-slate-400">MARKET</div>
                    <div class="font-extrabold text-slate-900">{formatTRY(item.marketPrice)}</div>
                  </div>
                  <div class="text-right">
                    <div class="text-[10px] text-slate-400">ONLİNE TABAN</div>
                    <div class="font-extrabold text-[#03519F]">{formatTRY(item.onlinePrice)}</div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- 6. TRANSPARENCY, METHODOLOGY & AI CITATION AUTHORITY STRIP -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="heg-white-card rounded-2xl p-6 space-y-2.5">
        <div class="w-10 h-10 rounded-xl bg-[#03519F]/10 text-[#03519F] flex items-center justify-center font-mono font-extrabold text-lg">01</div>
        <h3 class="text-base font-extrabold text-slate-950">%100 Tarafsız & Sponsorluksuz Puan</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Hiçbir markadan inceleme ücreti almıyoruz. Beş sabit kriterle hesaplanan HEG Puanı, gerçek kullanıcı şikayetlerini saklamadan paylaşır.
        </p>
      </div>

      <div class="heg-white-card rounded-2xl p-6 space-y-2.5">
        <div class="w-10 h-10 rounded-xl bg-[#FAD002]/25 text-[#0B0B0D] flex items-center justify-center font-mono font-extrabold text-lg">02</div>
        <h3 class="text-base font-extrabold text-slate-950">YouTube + Instagram + Bağımsız Web</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Videolu analizlerimizde zaman damgalı YouTube oynatıcıları yer alırken, videosu olmayan onlarca ürün de sitede bağımsız karneyle yayınlanır.
        </p>
      </div>

      <div class="heg-white-card rounded-2xl p-6 space-y-2.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-700 flex items-center justify-center font-mono font-extrabold text-lg">03</div>
        <h3 class="text-base font-extrabold text-slate-950">Açık Veri & AI Arama Standardı</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Tarih damgalı semantik fiyat tablolarımız, Schema.org verilerimiz ve <a href="/llms.txt" class="font-mono text-[#03519F] underline">/llms.txt</a> indeksimizle hem Google hem yapay zeka asistanları için doğrulanmış kaynağız.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
