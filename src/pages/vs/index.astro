---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonCard from '../../components/ComparisonCard.astro';
import { getAllComparisons } from '../../lib/content';

const comparisons = getAllComparisons();
---

<BaseLayout
  title="HEG VS — Bölünmüş Ekran Karşılaştırma & Puanlama"
  description="Türkiye'nin en çok merak edilen teknoloji ve ev ürünlerinin raund bazlı, Geekbench/AnTuTu benchmark destekli ve canlı çoklu mağaza fiyatlı tarafsız karşılaştırmaları."
  canonicalPath="/vs"
  activeNav="vs"
>
  <div class="max-w-[1240px] mx-auto px-5 py-8 space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="badge-pill badge-deal font-mono">HEG VS · KARAR AŞAMASI KARŞILAŞTIRMALARI</span>
        <h1 class="text-[28px] sm:text-[34px] font-semibold tracking-[-0.03em] text-[#111111] mt-2">
          İki Ürün. Net Raund Skorları. Sıfır Sponsorluk.
        </h1>
        <p class="text-[14px] text-[#52525B] mt-1 max-w-2xl">
          Her kriterde verilerle kazananı belirliyor, canlı Türkiye fiyatları ve gerçek kullanıcı yorumlarıyla final kararını veriyoruz.
        </p>
      </div>
      <a href="/asistan?vs=1" class="btn-pill btn-pill-primary">
        ⚖ Kendi 2 Ürününü Kıyasla <span class="arrow">↗</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[18px]">
      {comparisons.map((comp) => <ComparisonCard comparison={comp} />)}
    </div>
  </div>
</BaseLayout>
