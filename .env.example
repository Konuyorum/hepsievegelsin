# NVIDIA Developer (NIM) API Configuration (Primary AI Engine)
# IMPORTANT: Never commit real keys. Add as Encrypted Secret in Cloudflare Pages Dashboard.
NVIDIA_API_KEY=your_nvidia_nvapi_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional Free Live Web/Price Search Grounding (auto-activates if added as Cloudflare Secret)
# Tavily: 1,000 free searches/mo (https://tavily.com) | Serper: 2,500 free Google searches (https://serper.dev)
TAVILY_API_KEY=your_optional_tavily_key_here
SERPER_API_KEY=your_optional_serper_key_here

# Optional Fallback LLM Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_API_KEY=your_backup_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
